# Copy this file to `shopify.theme.toml` and replace the placeholder values.
# Shopify CLI environment docs:
# https://shopify.dev/docs/storefronts/themes/tools/cli/environments

[environments.dev]
store = "your-store.myshopify.com"

# Optional if you want to target a specific remote theme instead of a temporary
# development theme created by `shopify theme dev`.
# theme = "123456789012"

# Optional if you use Theme Access or a custom app token instead of account login.
# password = "shptka_xxxxxxxxxxxxxxxxxxxxx"

# Optional for storefronts protected by an online-store password page.
# store-password = "your-storefront-password"

# Keep non-theme workspace files out of CLI uploads/pulls.
ignore = [
  ".agents/*",
  "*.zip",
  "*.mp4",
  "*.mov",
  "*.log",
  "*.tmp",
  "*.bak",
  "*.backup"
]
