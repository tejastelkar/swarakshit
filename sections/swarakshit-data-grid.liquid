{% schema %}
{
  "name": "Swarakshit Data Grid",
  "tag": "section",
  "class": "section-data-grid",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAFAFA"
    }
  ],
  "blocks": [
    {
      "type": "data_point",
      "name": "Data Point",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Big Value (e.g. 85dB)",
          "default": "85dB"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Small Label",
          "default": "Siren Volume"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swarakshit Data Grid"
    }
  ]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding: clamp(80px, 12vw, 160px) 20px;
    font-family: 'Inter', sans-serif;
  }

  .swarakshit-data {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px; /* For the "border" effect */
    background-color: #E0E0E0; /* Grid line color */
    border: 2px solid #E0E0E0;
  }

  .swarakshit-data__item {
    background-color: {{ section.settings.bg_color }};
    padding: clamp(40px, 6vw, 80px) 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    transition: background-color 0.3s ease;
  }

  .swarakshit-data__item:hover {
    background-color: #F0F0F0;
  }

  .swarakshit-data__value {
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #111;
    margin: 0 0 16px 0;
    line-height: 1;
  }

  .swarakshit-data__label {
    font-size: clamp(14px, 1.5vw, 18px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #666;
    margin: 0;
  }

  @media (max-width: 989px) {
    .swarakshit-data {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .swarakshit-data {
      grid-template-columns: 1fr;
    }
  }
</style>

{%- if section.blocks.size > 0 -%}
<div class="swarakshit-data">
  {%- for block in section.blocks -%}
    <div class="swarakshit-data__item" {{ block.shopify_attributes }}>
      <div class="swarakshit-data__value">{{ block.settings.value }}</div>
      <div class="swarakshit-data__label">{{ block.settings.label }}</div>
    </div>
  {%- endfor -%}
</div>
{%- elsif request.design_mode -%}
  <div style="padding:40px;text-align:center;color:#999;font-size:16px;border:2px dashed #ddd;border-radius:12px;margin:20px;">
    Add data points using the block controls in the Customizer.
  </div>
{%- endif -%}
