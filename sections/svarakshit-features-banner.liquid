<style>
  .svarakshit-features-banner {
    background-color: {{ section.settings.bg_color }};
    padding: 60px 5rem;
    font-family: 'Inter', sans-serif;
  }

  .svarakshit-features-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
  }

  .svarakshit-feature-item {
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 16px;
    padding: 0 40px;
    position: relative;
  }

  /* Add border-right to all but the last item */
  .svarakshit-feature-item:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 5px;
    bottom: 5px;
    width: 1px;
    background-color: #f0f0f0;
  }

  .svarakshit-feature-icon {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    color: #000000;
  }

  .svarakshit-feature-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .svarakshit-feature-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .svarakshit-feature-title {
    font-size: 16px;
    font-weight: 500;
    color: #111111;
    line-height: 1.2;
    margin: 0;
  }

  .svarakshit-feature-subtitle {
    font-size: 13px;
    font-weight: 400;
    color: #555555;
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .svarakshit-features-banner {
      padding: 40px 2rem;
    }

    .svarakshit-features-container {
      flex-direction: column;
      gap: 32px;
    }

    .svarakshit-feature-item {
      padding: 0;
      width: 100%;
    }

    .svarakshit-feature-item:not(:last-child)::after {
      display: none;
    }
  }
</style>

<div class="svarakshit-features-banner">
  <div class="svarakshit-features-container">
    {% for block in section.blocks %}
      <div class="svarakshit-feature-item" {{ block.shopify_attributes }}>
        <div class="svarakshit-feature-icon">
          {{ block.settings.icon }}
        </div>
        <div class="svarakshit-feature-content">
          <h4 class="svarakshit-feature-title">{{ block.settings.title }}</h4>
          <p class="svarakshit-feature-subtitle">{{ block.settings.subtitle }}</p>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Swarakshit Features",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "limit": 4,
      "settings": [
        {
          "type": "html",
          "id": "icon",
          "label": "SVG Icon Code",
          "info": "Paste SVG code here. Recommended size 24x24."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swarakshit Features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Customer service",
            "subtitle": "Feel free to reach out to our team anytime",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 18v-6a9 9 0 0 1 18 0v6\"></path><path d=\"M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z\"></path></svg>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Fast Free Shipping",
            "subtitle": "Free shipping to Europe on orders over €170",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"16.5\" y1=\"9.4\" x2=\"7.5\" y2=\"4.21\"></line><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"></path><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"></polyline><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"></line></svg>"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Secure payment",
            "subtitle": "Your payment information is processed securely",
            "icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"></path><polyline points=\"9 12 11 14 15 10\"></polyline></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
