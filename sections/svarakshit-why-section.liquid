<style>
  .svarakshit-why-wrapper {
    background-color: #ffffff;
    width: 100%;
  }

  .svarakshit-why {
    padding-top: 40px;
    padding-bottom: 100px;
    padding-left: 5rem;
    padding-right: 5rem;
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 100px;
    font-family: 'Inter', sans-serif;
  }
  
  @media screen and (max-width: 989px) {
    .svarakshit-why {
      flex-direction: column;
      padding: 60px 2rem;
      gap: 40px;
    }
  }

  .svarakshit-why__heading-container {
    flex: 1;
    max-width: 500px;
    padding-right: 20px;
  }

  .svarakshit-why__heading {
    font-size: 3.5rem;
    font-weight: 800;
    margin: 0 0 16px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #111111;
  }

  @media screen and (max-width: 768px) {
    .svarakshit-why__heading {
      font-size: 2.5rem;
    }
  }

  .svarakshit-why__highlight {
    color: #000000;
  }

  .svarakshit-why__text-container {
    flex: 1.5;
    max-width: 900px;
    padding-top: 10px;
  }

  .svarakshit-why__text {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.8;
    color: #000000;
    margin: 0;
    font-weight: 400;
  }

  .svarakshit-why__text p {
    margin-top: 0;
    margin-bottom: 24px;
  }
  
  .svarakshit-why__text p:last-child {
    margin-bottom: 0;
  }

  .svarakshit-why__text strong {
    font-weight: 700;
    color: #000;
  }
</style>

<div class="svarakshit-why-wrapper">
  <div class="svarakshit-why">
    <div class="svarakshit-why__heading-container">
      <h2 class="svarakshit-why__heading">
        {%- assign highlight_html = '<span class="svarakshit-why__highlight">' | append: section.settings.highlight_word | append: '</span>' -%}
        {{ section.settings.heading | replace: section.settings.highlight_word, highlight_html }}
      </h2>
    </div>
    
    <div class="svarakshit-why__text-container">
      <div class="svarakshit-why__text">
        {{ section.settings.text }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Swarakshit Why Section",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why SWARAKSHIT?"
    },
    {
      "type": "text",
      "id": "highlight_word",
      "label": "Word to highlight",
      "default": "SWARAKSHIT",
      "info": "This word in the heading will get the golden wavy underline."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Swarakshit was created with the goal of helping people detect hazardous gas leaks early and make more informed decisions about their safety environment.</p><p>By monitoring gas levels, it's possible to <strong>prevent life-threatening accidents</strong>, as well as <strong>protect health from long-term exposure</strong> to toxic emissions or poor ventilation.</p><p>In this way, Swarakshit encourages everyone to secure their homes and workplaces every day.</p>"
    }
  ],
  "presets": [
    {
      "name": "Swarakshit Why Section"
    }
  ]
}
{% endschema %}
