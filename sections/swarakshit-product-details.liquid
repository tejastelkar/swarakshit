{% schema %}
{
  "name": "Swarakshit Details",
  "tag": "section",
  "class": "section-product-details",
  "settings": [
    {
      "type": "text",
      "id": "desc_title",
      "label": "Description Title",
      "default": "Description"
    },
    {
      "type": "richtext",
      "id": "desc_text",
      "label": "Description Text",
      "default": "<p><strong>Elegance:</strong> Embrace sophistication with the Elegance casing...</p>"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Device parameters"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swarakshit Details"
    }
  ]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} {
    padding: 80px 20px;
    font-family: 'Inter', sans-serif;
    border-top: 1px solid #EBEBEB;
    background: #FFFFFF;
  }

  #shopify-section-{{ section.id }} .swarakshit-details {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 80px;
  }

  .swarakshit-details__left {
    flex: 1;
  }

  .swarakshit-details__title {
    font-size: 18px;
    font-weight: 800;
    color: #111;
    margin: 0 0 16px 0;
  }

  .swarakshit-details__text {
    font-size: 15px;
    line-height: 1.6;
    color: #444;
  }

  .swarakshit-details__text p {
    margin: 0 0 16px 0;
  }

  .swarakshit-details__right {
    flex: 1;
  }

  .swarakshit-accordion {
    border-bottom: 1px solid #EBEBEB;
  }

  .swarakshit-accordion:first-child {
    border-top: 1px solid #EBEBEB;
  }

  .swarakshit-accordion__btn {
    width: 100%;
    background: none;
    border: none;
    padding: 24px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 16px;
    font-weight: 700;
    color: #111;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
  }

  .swarakshit-accordion__icon {
    font-size: 20px;
    font-weight: 300;
    transition: transform 0.3s ease;
  }

  .swarakshit-accordion__content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .swarakshit-accordion__inner {
    padding-bottom: 24px;
    font-size: 14px;
    line-height: 1.6;
    color: #555;
  }

  .swarakshit-accordion.is-open .swarakshit-accordion__content {
    max-height: 2000px;
  }

  .swarakshit-accordion.is-open .swarakshit-accordion__icon {
    transform: rotate(45deg);
  }

  @media (max-width: 768px) {
    .swarakshit-details {
      flex-direction: column;
      gap: 40px;
    }
  }
</style>

<div class="swarakshit-details">
  <div class="swarakshit-details__left">
    <h3 class="swarakshit-details__title">{{ section.settings.desc_title }}</h3>
    <div class="swarakshit-details__text">
      {{ section.settings.desc_text }}
    </div>
  </div>
  
  <div class="swarakshit-details__right">
    {%- for block in section.blocks -%}
      <div class="swarakshit-accordion js-accordion" {{ block.shopify_attributes }}>
        <button class="swarakshit-accordion__btn js-accordion-btn">
          {{ block.settings.title }}
          <span class="swarakshit-accordion__icon">+</span>
        </button>
        <div class="swarakshit-accordion__content">
          <div class="swarakshit-accordion__inner">
            {{ block.settings.content }}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const accordions = document.querySelectorAll('.js-accordion');
    accordions.forEach(acc => {
      const btn = acc.querySelector('.js-accordion-btn');
      btn.addEventListener('click', () => {
        // Close others (optional, Airvalent seems to allow multiple open)
        // accordions.forEach(a => { if (a !== acc) a.classList.remove('is-open'); });
        acc.classList.toggle('is-open');
      });
    });
  });
</script>
