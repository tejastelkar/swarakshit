{% schema %}
{
  "name": "Swarakshit App Promo",
  "tag": "section",
  "class": "section-app-promo",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#FAFAFA"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SWARAKSHIT App"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Download the SWARAKSHIT app to access your monitor's data and history, set CO2 measurement intervals, update your device, and customize notifications."
    },
    {
      "type": "url",
      "id": "appstore_url",
      "label": "App Store Link (iOS)"
    },
    {
      "type": "url",
      "id": "playstore_url",
      "label": "Play Store Link (Android)"
    },
    {
      "type": "image_picker",
      "id": "app_image",
      "label": "App Image"
    }
  ],
  "presets": [
    {
      "name": "Swarakshit App Promo"
    }
  ]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FAFAFA' }};
    padding: 80px 20px;
    font-family: 'Inter', sans-serif;
  }

  .swarakshit-app {
    max-width: 1200px;
    margin: 0 auto;
    background-color: #111;
    border-radius: 8px;
    display: flex;
    overflow: hidden;
    min-height: 400px;
  }

  .swarakshit-app__content {
    flex: 1;
    padding: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .swarakshit-app__title {
    font-size: clamp(32px, 4vw, 40px);
    font-weight: 800;
    color: #FFF;
    margin: 0 0 24px 0;
    letter-spacing: -0.02em;
  }

  .swarakshit-app__text {
    font-size: 14px;
    line-height: 1.6;
    color: #CCC;
    margin: 0;
    max-width: 400px;
  }

  .swarakshit-app__media {
    flex: 1;
    background-color: #1A1A1A;
    position: relative;
    min-height: 400px;
  }

  .swarakshit-app__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  @media (max-width: 768px) {
    .swarakshit-app {
      flex-direction: column;
    }
    .swarakshit-app__content {
      padding: 40px 20px;
    }
    .swarakshit-app__media {
      min-height: 300px;
    }
  }
</style>

<div class="swarakshit-app">
  <div class="swarakshit-app__content">
    <h2 class="swarakshit-app__title">{{ section.settings.title }}</h2>
    <p class="swarakshit-app__text">{{ section.settings.text }}</p>
    {%- if section.settings.appstore_url != blank or section.settings.playstore_url != blank -%}
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px;">
        {%- if section.settings.appstore_url != blank -%}
          <a href="{{ section.settings.appstore_url }}" target="_blank" rel="noopener" aria-label="Download on the App Store"
             style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:#fff;color:#111;border-radius:8px;text-decoration:none;font-weight:600;font-size:14px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
            App Store
          </a>
        {%- endif -%}
        {%- if section.settings.playstore_url != blank -%}
          <a href="{{ section.settings.playstore_url }}" target="_blank" rel="noopener" aria-label="Get it on Google Play"
             style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:#fff;color:#111;border-radius:8px;text-decoration:none;font-weight:600;font-size:14px;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.18 23.76c.3.16.64.2.99.11l13.5-7.8-2.9-2.89zm15.15-8.76L4.47 7.12 16.35 3.2zM2.1 1.28C2.04 1.5 2 1.74 2 2v20c0 .26.04.5.1.72l.06.06 11.2-11.2v-.28L2.16 1.22zm18.22 10.5-2.67-1.54-3.08 3.08 3.08 3.08 2.69-1.56c.77-.45.77-1.61-.02-2.06z"/></svg>
            Play Store
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
  <div class="swarakshit-app__media">
    {%- if section.settings.app_image != blank -%}
      {{ section.settings.app_image | image_url: width: 800 | image_tag: class: 'swarakshit-app__image', loading: 'lazy' }}
    {%- endif -%}
  </div>
</div>
