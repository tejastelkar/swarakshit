{% schema %}
{
  "name": "Swarakshit App Promo",
  "tag": "section",
  "class": "section-app-promo",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "SWARAKSHIT App"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Download the SWARAKSHIT app to access your monitor's data and history, set CO2 measurement intervals, update your device, and customize notifications."
    },
    {
      "type": "image_picker",
      "id": "app_image",
      "label": "App Image"
    }
  ],
  "presets": [
    {
      "name": "Swarakshit App Promo"
    }
  ]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} {
    background-color: #FAFAFA; /* The outer background if we want it */
    padding: 80px 20px;
    font-family: 'Inter', sans-serif;
  }

  .swarakshit-app {
    max-width: 1200px;
    margin: 0 auto;
    background-color: #111;
    border-radius: 8px;
    display: flex;
    overflow: hidden;
    min-height: 400px;
  }

  .swarakshit-app__content {
    flex: 1;
    padding: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .swarakshit-app__title {
    font-size: clamp(32px, 4vw, 40px);
    font-weight: 800;
    color: #FFF;
    margin: 0 0 24px 0;
    letter-spacing: -0.02em;
  }

  .swarakshit-app__text {
    font-size: 14px;
    line-height: 1.6;
    color: #CCC;
    margin: 0;
    max-width: 400px;
  }

  .swarakshit-app__media {
    flex: 1;
    background-color: #1A1A1A; /* Slightly lighter black or grey to mimic Airvalent's empty state */
    position: relative;
  }

  .swarakshit-app__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .swarakshit-app {
      flex-direction: column;
    }
    .swarakshit-app__content {
      padding: 40px 20px;
    }
    .swarakshit-app__media {
      min-height: 300px;
    }
  }
</style>

<div class="swarakshit-app">
  <div class="swarakshit-app__content">
    <h2 class="swarakshit-app__title">{{ section.settings.title }}</h2>
    <p class="swarakshit-app__text">{{ section.settings.text }}</p>
  </div>
  <div class="swarakshit-app__media">
    {%- if section.settings.app_image != blank -%}
      {{ section.settings.app_image | image_url: width: 800 | image_tag: class: 'swarakshit-app__image', loading: 'lazy' }}
    {%- endif -%}
  </div>
</div>
