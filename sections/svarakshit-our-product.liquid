<style>
  #shopify-section-{{ section.id }} {
    --o:#E87722;--od:#C5611A;--ol:#FF9A4D;
    --green:#22C55E;--r:12px;--rxl:32px;
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    font-family: 'Inter', sans-serif;
  }
  
  .svarakshit-product-inner {
    padding-top: 48px;
    padding-bottom: 100px;
    padding-left: 5rem;
    padding-right: 5rem;
    max-width: 100%;
    margin: 0 auto;
  }
  @media screen and (max-width: 989px) {
    .svarakshit-product-inner {
      padding: 40px 2rem 60px;
    }
  }

  /* Section Header */
  #shopify-section-{{ section.id }} .sec-head { margin-bottom: 60px; }
  #shopify-section-{{ section.id }} .sec-head.center { text-align: center; }
  #shopify-section-{{ section.id }} .sec-tag-top {
    display:inline-flex;align-items:center;gap:6px;background:rgba(232,119,34,.12);border:1px solid rgba(232,119,34,.25);color:var(--od);padding:6px 14px;border-radius:100px;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:14px;
  }
  #shopify-section-{{ section.id }} .sec-title { 
    font-size: clamp(1.8rem,3.5vw,2.8rem); font-weight: 900; letter-spacing: -.04em; line-height: 1.12; margin-bottom: 14px; color: {{ section.settings.heading_color }}; 
  }
  #shopify-section-{{ section.id }} .sec-sub { 
    font-size: 16px; color: {{ section.settings.text_color | color_modify: 'alpha', 0.7 }}; line-height: 1.75; max-width: 540px; margin: 0 auto; 
  }

  /* Product specific tag */
  #shopify-section-{{ section.id }} .sec-tag {
    display:inline-flex;align-items:center;gap:6px;background:rgba(232,119,34,.12);border:1px solid rgba(232,119,34,.25);color:var(--od);padding:6px 14px;border-radius:100px;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin-bottom:14px;
  }
  #shopify-section-{{ section.id }} .prod-grid {
    display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:start;
  }
  #shopify-section-{{ section.id }} .prod-gallery {
    position:sticky;top:88px;
  }
  #shopify-section-{{ section.id }} .prod-main {
    width:100%;height:clamp(320px,42vw,640px);object-fit:cover;border-radius:var(--rxl);background:transparent;border:none;box-shadow:none;padding:0;cursor:zoom-in;display:block;
  }
  #shopify-section-{{ section.id }} .prod-thumbs {
    display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-top:10px;
  }
  #shopify-section-{{ section.id }} .thumb {
    aspect-ratio:1;border-radius:10px;border:2px solid transparent;cursor:pointer;overflow:hidden;background:transparent;transition:all .2s;position:relative;
  }
  #shopify-section-{{ section.id }} .thumb::after {
    content:'';position:absolute;inset:0;background:rgba(232,119,34,.15);opacity:0;transition:opacity .2s;
  }
  #shopify-section-{{ section.id }} .thumb:hover::after, #shopify-section-{{ section.id }} .thumb.act::after {
    opacity:1;
  }
  #shopify-section-{{ section.id }} .thumb.act {
    border-color:var(--o);box-shadow:0 0 16px rgba(232,119,34,.2);
  }
  #shopify-section-{{ section.id }} .thumb img {
    width:100%;height:100%;object-fit:cover;padding:0;border-radius:8px;
  }
  #shopify-section-{{ section.id }} .prod-price-row {
    display:flex;align-items:baseline;gap:12px;margin-bottom:24px;
  }
  #shopify-section-{{ section.id }} .p-main {
    font-size:2.4rem;font-weight:700;color:#000000;
  }
  #shopify-section-{{ section.id }} .p-mrp {
    font-size:1rem;color:{{ section.settings.text_color | color_modify: 'alpha', 0.5 }};text-decoration:line-through;
  }
  #shopify-section-{{ section.id }} .p-save {
    background:var(--green);color:#fff;font-size:.72rem;font-weight:800;padding:3px 10px;border-radius:100px;
  }
  #shopify-section-{{ section.id }} .prod-rating {
    display:flex;align-items:center;gap:8px;margin-bottom:20px;
  }
  #shopify-section-{{ section.id }} .prod-rating .jdgm-widget,
  #shopify-section-{{ section.id }} .prod-rating .jdgm-prev-badge {
    display:inline-flex !important;align-items:center;flex-wrap:wrap;gap:8px;
  }
  #shopify-section-{{ section.id }} .prod-rating .jdgm-prev-badge__stars {
    display:inline-flex;align-items:center;
  }
  #shopify-section-{{ section.id }} .prod-rating .jdgm-star,
  #shopify-section-{{ section.id }} .prod-rating .jdgm-prev-badge__stars .jdgm-star {
    color:#E87722 !important;
  }
  #shopify-section-{{ section.id }} .prod-rating .jdgm-prev-badge__text,
  #shopify-section-{{ section.id }} .prod-rating .jdgm-prev-badge__text,
  #shopify-section-{{ section.id }} .prod-rating .jdgm-rev-widg__summary-text,
  #shopify-section-{{ section.id }} .prod-rating .jdgm-prev-badge__text,
  #shopify-section-{{ section.id }} .prod-rating .jdgm-star + .jdgm-prev-badge__text {
    color:{{ section.settings.text_color | color_modify: 'alpha', 0.7 }} !important;
    font-family:'Inter', sans-serif !important;
    font-size:.95rem !important;
    font-weight:500 !important;
    line-height:1.4 !important;
  }
  #shopify-section-{{ section.id }} .prod-rating .jdgm-prev-badge__text,
  #shopify-section-{{ section.id }} .prod-rating .jdgm-rev-widg__summary-average,
  #shopify-section-{{ section.id }} .prod-rating .jdgm-rev-widg__summary-text {
    visibility:visible !important;
  }
  #shopify-section-{{ section.id }} .stars {
    color:#F59E0B;letter-spacing:2px;
  }
  #shopify-section-{{ section.id }} .rnum {
    font-weight:700;font-size:.9rem;color: {{ section.settings.heading_color }};
  }
  #shopify-section-{{ section.id }} .rcnt {
    font-size:.8rem;color:{{ section.settings.text_color | color_modify: 'alpha', 0.6 }};
  }
  #shopify-section-{{ section.id }} .feat-list {
    margin-bottom:28px;display:flex;flex-direction:column;gap:2px;
  }
  #shopify-section-{{ section.id }} .feat {
    display:flex;align-items:flex-start;gap:12px;padding:14px;border-radius:var(--r);
  }
  #shopify-section-{{ section.id }} .feat-ic {
    width:36px;height:36px;display:flex;align-items:center;justify-content:center;color:{{ section.settings.heading_color }};flex-shrink:0;
  }
  #shopify-section-{{ section.id }} .feat-ic svg {
    width: 24px; height: 24px;
  }
  #shopify-section-{{ section.id }} .ft {
    font-size:16px;font-weight:700;color:{{ section.settings.heading_color }};margin-bottom:3px;
  }
  #shopify-section-{{ section.id }} .fd {
    font-size:16px;color:{{ section.settings.text_color | color_modify: 'alpha', 0.7 }};line-height:1.5;
  }
  #shopify-section-{{ section.id }} .qty-row {
    display:flex;align-items:center;gap:16px;margin-bottom:16px;
  }
  #shopify-section-{{ section.id }} .qty-ctrl {
    display:flex;align-items:center;border:1.5px solid rgba(0,0,0,.08);border-radius:40px;overflow:hidden;height:48px;width:130px;background:#fcfcfc;
  }
  #shopify-section-{{ section.id }} .qbtn {
    width:40px;height:100%;background:none;color:{{ section.settings.text_color }};font-size:1.2rem;font-weight:500;display:flex;align-items:center;justify-content:center;cursor:pointer;border:none;font-family:inherit;transition:all 0.2s;
  }
  #shopify-section-{{ section.id }} .qbtn:hover {
    color:var(--o);background:rgba(0,0,0,0.03);
  }
  #shopify-section-{{ section.id }} .qnum {
    flex:1;text-align:center;background:none;border:none;color:{{ section.settings.text_color }};font-family:inherit;font-weight:800;font-size:1.18rem;outline:none;pointer-events:none;
  }
  #shopify-section-{{ section.id }} .prod-ctas {
    display:flex;gap:12px;margin-bottom:16px;
  }
  #shopify-section-{{ section.id }} .btn-ac {
    flex:1;height:52px;padding:0 20px;border-radius:40px;font-size:17px;font-weight:800;background:#111111;color:#ffffff;border:none;cursor:pointer;font-family:inherit;transition:all .25s;display:flex;align-items:center;justify-content:center;gap:8px;
  }
  #shopify-section-{{ section.id }} .btn-ac:hover {
    opacity:0.8;
  }
  #shopify-section-{{ section.id }} .btn-bn {
    flex:1;height:50px;padding:0 20px;border-radius:40px;font-size:16px;font-weight:700;background:var(--o);color:#ffffff;border:none;cursor:pointer;font-family:inherit;transition:all .25s;display:flex;align-items:center;justify-content:center;gap:8px;
  }
  #shopify-section-{{ section.id }} .btn-bn:hover {
    background:var(--od);
  }
  #shopify-section-{{ section.id }} .btn-wa {
    width:100%;height:50px;border-radius:40px;font-size:16px;font-weight:700;background:rgba(37,211,102,.12);color:#1E8C45;border:1.5px solid rgba(37,211,102,.3);cursor:pointer;font-family:inherit;transition:all .25s;display:flex;align-items:center;justify-content:center;gap:8px;
  }
  #shopify-section-{{ section.id }} .btn-wa:hover {
    background:#25D366;color:#fff;box-shadow:0 0 30px rgba(37,211,102,.3);
  }
  #shopify-section-{{ section.id }} .guar {
    display:flex;flex-wrap:wrap;gap:14px;margin-top:18px;
  }
  #shopify-section-{{ section.id }} .guar-i {
    font-size:16px;font-weight:600;color:{{ section.settings.text_color | color_modify: 'alpha', 0.7 }};display:flex;align-items:center;gap:5px;
  }
  #shopify-section-{{ section.id }} .guar-i svg {
    width: 18px; height: 18px; color: {{ section.settings.heading_color }};
  }
  
  @media(max-width:1280px){
    #shopify-section-{{ section.id }} .prod-grid {
      gap:32px;
    }
  }
  @media(max-width:1024px){
    #shopify-section-{{ section.id }} .prod-grid {
      grid-template-columns:1fr;
    }
    #shopify-section-{{ section.id }} .prod-gallery {
      position:static;
    }
    #shopify-section-{{ section.id }} .prod-main {
      height:clamp(280px,70vw,520px);
    }
  }
</style>

{% assign product = section.settings.product %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_summary = '' %}
{% if product != blank %}
  {% if product.metafields.custom.short_description != blank %}
    {% assign product_summary = product.metafields.custom.short_description | strip_html | strip %}
  {% elsif product.description != blank %}
    {% assign description_paragraphs = product.description | split: '</p>' %}
    {% for paragraph in description_paragraphs %}
      {% assign clean_paragraph = paragraph | strip_html | strip %}
      {% if clean_paragraph != blank %}
        {% assign product_summary = clean_paragraph %}
        {% break %}
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

<section>
  <div class="svarakshit-product-inner">
    
    <div class="prod-grid">
      <div>
        <div class="prod-gallery">
          {% if product != blank and product.featured_image %}
            <img
              src="{{ product.featured_image | image_url: width: 800 }}"
              alt="{{ product.title | escape }}"
              class="prod-main"
              id="mainImg-{{ section.id }}"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
            
            {% if product.images.size > 1 %}
            <div class="prod-thumbs">
              {% for image in product.images %}
                <div class="thumb {% if forloop.first %}act{% endif %}" onclick="setImg_{{ section.id | replace: '-', '_' }}(this, '{{ image | image_url: width: 800 }}')">
                  <img
                    src="{{ image | image_url: width: 150 }}"
                    alt="{{ image.alt | escape }}"
                    width="{{ image.width }}"
                    height="{{ image.height }}"
                  >
                </div>
              {% endfor %}
            </div>
            {% endif %}
          {% else %}
            {% render 'svarakshit-fallback-image',
              context: 'product main',
              alt: section.settings.title,
              class: 'prod-main',
              loading: 'lazy'
            %}
          {% endif %}
        </div>
      </div>
      
      <div>
        <h2 style="font-size:30px;font-weight:900;letter-spacing:-.04em;color:{{ section.settings.heading_color }};margin-bottom:6px">{{ product.title | default: section.settings.title }}</h2>
        
        {% if product_summary != blank %}
        <p style="font-size:16px;color:{{ section.settings.text_color | color_modify: 'alpha', 0.6 }};margin-bottom:18px">{{ product_summary }}</p>
        {% elsif section.settings.subtitle != blank %}
        <p style="font-size:16px;color:{{ section.settings.text_color | color_modify: 'alpha', 0.6 }};margin-bottom:18px">{{ section.settings.subtitle }}</p>
        {% endif %}
        
        {% if product != blank %}
        <div class="prod-rating" aria-label="Customer reviews summary">
          <div
            class="jdgm-widget jdgm-preview-badge"
            data-id="{{ product.id }}"
            data-auto-install="false"
          >
            {{ product.metafields.judgeme.badge }}
          </div>
        </div>
        {% endif %}
        {% if product != blank and product.metafields.judgeme.review_widget_data %}
          <script>
            window.jdgm = window.jdgm || {};
            jdgm.data ||= {};
            jdgm.data.reviewWidget ||= {};
            jdgm.data.reviewWidget[{{ product.id }}] = {{ product.metafields.judgeme.review_widget_data }};
          </script>
        {% endif %}
        
        <div class="prod-price-row">
          {%- if product != blank and current_variant != blank -%}
            <span class="p-main">{{ current_variant.price | money }}</span>
            {% if current_variant.compare_at_price > current_variant.price %}
              <span class="p-mrp">{{ current_variant.compare_at_price | money }}</span>
              {% assign savings = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round %}
              <span class="p-save">{{ savings }}% OFF</span>
            {% endif %}
          {%- elsif product != blank -%}
            <span class="p-main">{{ product.price | money }}</span>
          {%- else -%}
            <span class="p-main" style="font-size:1.2rem;color:#aaa;">Select a product in the Customizer</span>
          {%- endif -%}
        </div>
        
        <div class="feat-list">
          {% for block in section.blocks %}
            {% if block.type == 'feature' %}
            <div class="feat">
              <div class="feat-ic">{{ block.settings.svg_icon }}</div>
              <div>
                <div class="ft">{{ block.settings.title }}</div>
                <div class="fd">{{ block.settings.description }}</div>
              </div>
            </div>
            {% endif %}
          {% endfor %}
        </div>
        
        {%- if product != blank -%}
        <form
          method="post"
          action="{{ routes.cart_add_url }}"
          id="product-form-{{ section.id }}"
          class="svarakshit-product-form"
        >
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          
          <div class="qty-row">
            <span style="font-size:14px;font-weight:600;color:{{ section.settings.text_color | color_modify: 'alpha', 0.7 }}">Qty:</span>
            <div class="qty-ctrl">
              <button type="button" class="qbtn" onclick="changeQty_{{ section.id | replace: '-', '_' }}(-1)">−</button>
              <input class="qnum" id="qnum-{{ section.id }}" type="number" name="quantity" value="1" min="1" max="10" readonly>
              <button type="button" class="qbtn" onclick="changeQty_{{ section.id | replace: '-', '_' }}(1)">+</button>
            </div>
          </div>
          
          <div class="prod-ctas">
            <button type="submit" name="add" class="btn-ac" data-add-to-cart>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
              <span>Add to Cart</span>
            </button>
            <button type="button" class="btn-bn" onclick="checkoutNow_{{ section.id | replace: '-', '_' }}()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
              Buy Now
            </button>
          </div>
        </form>
        {%- endif -%}
        
        {% if section.settings.whatsapp_number != blank %}
        <a href="https://wa.me/{{ section.settings.whatsapp_number }}?text={{ section.settings.whatsapp_message | url_encode }}" target="_blank" class="btn-wa" style="text-decoration:none;display:flex">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
            <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
          </svg>
          Order via WhatsApp
        </a>
        {% endif %}
        
        <div class="guar">
          {% for block in section.blocks %}
            {% if block.type == 'guarantee' %}
              <span class="guar-i">
                {{ block.settings.svg_icon }}
                {{ block.settings.text }}
              </span>
            {% endif %}
          {% endfor %}
        </div>
        
      </div>
    </div>
  </div>
</section>

<script>
  function setImg_{{ section.id | replace: '-', '_' }}(thumbElement, imageUrl) {
    document.getElementById('mainImg-{{ section.id }}').src = imageUrl;
    var thumbs = thumbElement.parentElement.getElementsByClassName('thumb');
    for (var i = 0; i < thumbs.length; i++) {
      thumbs[i].classList.remove('act');
    }
    thumbElement.classList.add('act');
  }
  
  function changeQty_{{ section.id | replace: '-', '_' }}(change) {
    var input = document.getElementById('qnum-{{ section.id }}');
    var newVal = parseInt(input.value) + change;
    if (newVal >= 1 && newVal <= 10) {
      input.value = newVal;
    }
  }

  function checkoutNow_{{ section.id | replace: '-', '_' }}() {
    var form = document.getElementById('product-form-{{ section.id }}');
    var input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'return_to';
    input.value = '/checkout';
    form.appendChild(input);
    form.submit();
  }

  (function() {
    var form = document.getElementById('product-form-{{ section.id }}');
    if (!form || form.dataset.ajaxBound === 'true') return;

    form.dataset.ajaxBound = 'true';

    form.addEventListener('submit', function(event) {
      event.preventDefault();

      var submitButton = form.querySelector('[data-add-to-cart]');
      var buttonLabel = submitButton ? submitButton.querySelector('span') : null;
      var cartDrawer = document.querySelector('cart-drawer');

      if (!submitButton) return;
      if (submitButton.disabled) return;

      submitButton.disabled = true;
      if (buttonLabel) buttonLabel.textContent = 'Adding...';

      /* Use fetchConfig if available (Dawn theme), else build config manually */
      var config;
      if (typeof fetchConfig === 'function') {
        config = fetchConfig('javascript');
        config.headers['X-Requested-With'] = 'XMLHttpRequest';
        delete config.headers['Content-Type'];
      } else {
        config = { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/javascript' } };
      }

      var formData = new FormData(form);

      if (cartDrawer && typeof cartDrawer.getSectionsToRender === 'function') {
        formData.append(
          'sections',
          cartDrawer.getSectionsToRender().map(function(section) {
            return section.id;
          })
        );
        formData.append('sections_url', window.location.pathname);
        if (typeof cartDrawer.setActiveElement === 'function') {
          cartDrawer.setActiveElement(document.activeElement);
        }
      }

      config.body = formData;

      var cartAddUrl = (window.routes && window.routes.cart_add_url) ? window.routes.cart_add_url : '/cart/add.js';
      var cartUrl = (window.routes && window.routes.cart_url) ? window.routes.cart_url : '/cart';

      fetch(cartAddUrl, config)
        .then(function(response) {
          return response.json();
        })
        .then(function(response) {
          if (response.status) {
            throw new Error(response.description || 'Unable to add this item to the cart.');
          }

          if (cartDrawer && typeof cartDrawer.renderContents === 'function') {
            cartDrawer.renderContents(response);
          } else {
            window.location.href = cartUrl;
          }
        })
        .catch(function(error) {
          console.error(error);
          window.alert(error.message || 'Unable to add this item to the cart.');
        })
        .finally(function() {
          submitButton.disabled = false;
          if (buttonLabel) buttonLabel.textContent = 'Add to Cart';
        });
    });
  })();
</script>

{% schema %}
{
  "name": "Swarakshit Our Product",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Product Details"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
