<style>
  #shopify-section-{{ section.id }} .svarakshit-app-text {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 5rem 1.5rem;
    font-family: 'Inter', sans-serif;
  }
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .svarakshit-app-text {
      padding: 10rem 5rem;
    }
  }

  #shopify-section-{{ section.id }} .svarakshit-app-text__container {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .svarakshit-app-text__container {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }
  }

  #shopify-section-{{ section.id }} .svarakshit-app-text__title {
    font-size: clamp(2.5rem, 8vw, 7rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0;
    white-space: pre-line;
    color: {{ section.settings.text_color }};
    /* Sticky only on desktop where there's enough content to scroll past */
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .svarakshit-app-text__title {
      position: sticky;
      top: 4rem;
    }
  }

  #shopify-section-{{ section.id }} .svarakshit-app-text__content {
    font-size: 1.6rem;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.85;
    max-width: 600px;
  }

  #shopify-section-{{ section.id }} .svarakshit-app-text__content p {
    margin-bottom: 2rem;
  }
  #shopify-section-{{ section.id }} .svarakshit-app-text__content p:last-child {
    margin-bottom: 0;
  }
</style>

<div class="svarakshit-app-text">
  <div class="svarakshit-app-text__container">
    <div class="svarakshit-app-text__left">
      {% if section.settings.title != blank %}
        <h2 class="svarakshit-app-text__title">{{ section.settings.title | newline_to_br }}</h2>
      {% endif %}
    </div>
    <div class="svarakshit-app-text__right">
      {% if section.settings.content != blank %}
        <div class="svarakshit-app-text__content">
          {{ section.settings.content }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Application Text Block",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Left Title",
      "default": "SWARAKSHIT\nMonitoring\nSystem"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Right Content",
      "default": "<p>Swarakshit is a portable AAA battery-powered gas monitor designed to help households check for combustible gas leaks around kitchens and other home gas connection points.</p><p>Use it as part of a regular safety routine near LPG cylinders, PNG joints, regulators, burner connections, and gas appliances where early detection matters most.</p>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Application Text Block"
    }
  ]
}
{% endschema %}
