<style>
  .svarakshit-cinematic-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: #000;
    font-family: 'Inter', sans-serif;
  }

  .svarakshit-cinematic-hero__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .svarakshit-cinematic-hero__bg img,
  .svarakshit-cinematic-hero__bg svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: kenBurns 25s ease-in-out infinite alternate;
    transform-origin: center;
  }

  @keyframes kenBurns {
    0% { transform: scale(1); }
    100% { transform: scale(1.1); }
  }

  .svarakshit-cinematic-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.8) 100%);
    z-index: 2;
  }

  .svarakshit-cinematic-hero__content {
    position: relative;
    z-index: 3;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 2rem;
    max-width: 1200px;
    margin-top: -5vh;
  }

  .svarakshit-cinematic-hero__pill {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 8px 24px;
    border-radius: 100px;
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 32px;
    opacity: 0;
    animation: fadeInUp 1s ease 0.2s forwards;
  }

  .svarakshit-cinematic-hero__heading {
    color: #ffffff;
    font-size: clamp(60px, 10vw, 140px);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin: 0;
    opacity: 0;
    animation: fadeInUp 1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .svarakshit-cinematic-hero__scroll {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: rgba(255,255,255,0.6);
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-decoration: none;
    opacity: 0;
    animation: fadeIn 1s ease 1s forwards;
  }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  .svarakshit-cinematic-hero__scroll-line {
    width: 1px;
    height: 40px;
    background: rgba(255,255,255,0.2);
    margin-top: 12px;
    position: relative;
    overflow: hidden;
  }

  .svarakshit-cinematic-hero__scroll-line::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 50%;
    background: #ffffff;
    animation: scrollDrop 2s ease-in-out infinite;
  }

  @keyframes scrollDrop {
    0% { transform: translateY(-100%); }
    50% { transform: translateY(200%); }
    100% { transform: translateY(200%); }
  }
</style>

<div class="svarakshit-cinematic-hero">
  <div class="svarakshit-cinematic-hero__bg">
    {% if section.settings.image %}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt="{{ section.settings.heading | escape }}"
        loading="eager"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {% else %}
      {% render 'svarakshit-fallback-image',
        context: section.settings.heading,
        alt: section.settings.heading,
        class: 'placeholder-svg',
        loading: 'eager'
      %}
    {% endif %}
  </div>

  <div class="svarakshit-cinematic-hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>

  <div class="svarakshit-cinematic-hero__content">
    {% if section.settings.subtitle != blank %}
      <div class="svarakshit-cinematic-hero__pill">{{ section.settings.subtitle }}</div>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="svarakshit-cinematic-hero__heading">{{ section.settings.heading }}</h1>
    {% endif %}
  </div>

  <a href="#intro" class="svarakshit-cinematic-hero__scroll">
    Explore
    <div class="svarakshit-cinematic-hero__scroll-line"></div>
  </a>
</div>

{% schema %}
{
  "name": "Cinematic Hero",
  "tag": "section",
  "class": "section-usecase-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Home Kitchens"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle (Glass Pill)",
      "default": "Uncompromised Safety."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Cinematic Hero"
    }
  ]
}
{% endschema %}
