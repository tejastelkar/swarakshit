<style>
  #shopify-section-{{ section.id }} .svarakshit-app-contact {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 6rem 1.5rem;
    font-family: 'Inter', sans-serif;
    text-align: center;
  }
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .svarakshit-app-contact {
      padding: 10rem 5rem;
    }
  }

  #shopify-section-{{ section.id }} .svarakshit-app-contact__container {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .svarakshit-app-contact__header {
    margin-bottom: 3rem;
  }

  #shopify-section-{{ section.id }} .svarakshit-app-contact__title {
    font-size: clamp(30px, 6vw, 50px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin: 0 0 1rem 0;
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .svarakshit-app-contact__subtitle {
    font-size: 18px;
    font-weight: 400;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
  }

  .svarakshit-app-contact__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.2rem 3.5rem;
    background-color: {{ section.settings.btn_color }};
    color: {{ section.settings.btn_text_color }};
    border-radius: 100px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.8rem;
    letter-spacing: normal;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .svarakshit-app-contact__btn:hover {
    transform: scale(1.02);
    opacity: 0.9;
  }
  
  .svarakshit-app-contact__btn svg {
    width: 24px;
    height: 24px;
    transition: transform 0.3s ease;
  }
  
  .svarakshit-app-contact__btn:hover svg {
    transform: translateX(5px);
  }
</style>

<div class="svarakshit-app-contact">
  <div class="svarakshit-app-contact__container">
    <div class="svarakshit-app-contact__header">
      {% if section.settings.title != blank %}
        <h2 class="svarakshit-app-contact__title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.subtitle != blank %}
        <div class="svarakshit-app-contact__subtitle">{{ section.settings.subtitle }}</div>
      {% endif %}
    </div>

    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link | default: '/products/smart-gas-leak-detector' }}" class="svarakshit-app-contact__btn">
        {{ section.settings.button_text }}
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Application CTA",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Ready to secure your premises?"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Get the Swarakshit Smart Gas Leak Detector today and ensure peace of mind for you and your team."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Buy Swarakshit Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Button Background Color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Application CTA"
    }
  ]
}
{% endschema %}
