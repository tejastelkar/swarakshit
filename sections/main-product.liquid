<div class="av-sticky-cart" id="av-sticky-cart">
  {% if product.featured_image %}
    <img
      src="{{ product.featured_image | image_url: width: 100, height: 100 }}"
      alt="{{ product.title | escape }}"
      class="av-sticky-cart__img"
      width="100"
      height="100"
      loading="lazy"
    >
  {% endif %}
  <div class="av-sticky-cart__info">
    <p class="av-sticky-cart__title">{{ product.title }}</p>
    <p class="av-sticky-cart__price">{{ product.price | money }}</p>
  </div>
  <button type="button" class="av-sticky-cart__btn" id="av-sticky-cart-btn">
    Add to cart
  </button>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const stickyCart = document.getElementById('av-sticky-cart');
    const mainAtcBtn = document.querySelector('.av-info__atc');
    const stickyAtcBtn = document.getElementById('av-sticky-cart-btn');
    const productForm = document.getElementById('av-product-form');
    const cartDrawer = document.querySelector('cart-drawer');

    const submitProductToCartDrawer = async (triggerButton) => {
      if (!productForm || !window.fetchConfig || triggerButton?.dataset.loading === 'true') return;

      const config = fetchConfig('javascript');
      config.headers['X-Requested-With'] = 'XMLHttpRequest';
      delete config.headers['Content-Type'];

      const formData = new FormData(productForm);

      if (cartDrawer) {
        formData.append(
          'sections',
          cartDrawer.getSectionsToRender().map((section) => section.id)
        );
        formData.append('sections_url', window.location.pathname);
        cartDrawer.setActiveElement(triggerButton || document.activeElement);
      }

      config.body = formData;

      if (triggerButton) {
        triggerButton.dataset.loading = 'true';
        triggerButton.setAttribute('aria-disabled', 'true');
        triggerButton.disabled = true;
      }

      try {
        const response = await fetch(`${routes.cart_add_url}`, config);
        const responseJson = await response.json();

        if (responseJson.status) {
          console.error('Sticky cart add failed:', responseJson.description || responseJson.message || responseJson.errors);
          return;
        }

        if (cartDrawer) {
          if (cartDrawer.classList.contains('is-empty')) {
            cartDrawer.classList.remove('is-empty');
          }
          cartDrawer.renderContents(responseJson);
          return;
        }

        window.location = window.routes.cart_url;
      } catch (error) {
        console.error('Sticky cart add failed:', error);
      } finally {
        if (triggerButton) {
          delete triggerButton.dataset.loading;
          triggerButton.removeAttribute('aria-disabled');
          triggerButton.disabled = false;
        }
      }
    };
    
    if (stickyCart && mainAtcBtn) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
            stickyCart.classList.add('is-visible');
          } else {
            stickyCart.classList.remove('is-visible');
          }
        });
      }, { threshold: 0 });
      
      observer.observe(mainAtcBtn);
    }

    if (productForm) {
      productForm.addEventListener('submit', (event) => {
        event.preventDefault();
        submitProductToCartDrawer(mainAtcBtn);
      });
    }

    if (stickyAtcBtn) {
      stickyAtcBtn.addEventListener('click', () => {
        submitProductToCartDrawer(stickyAtcBtn);
      });
    }
  });

  /* ── Gallery helpers ───────────────────── */
  window.avProductMedias = [
    {%- for media in product.media -%}
      {%- if media.media_type == 'image' -%}
        "{{ media | image_url: width: 2048 }}"{% unless forloop.last %},{% endunless %}
      {%- endif -%}
    {%- endfor -%}
  ];
  window.avCurrentIndex = 0;
  window.avLbIndex = 0;

  function avSetMain(thumb) {
    var src = thumb.dataset.src;
    var fullSrc = thumb.dataset.full || src;
    var index = parseInt(thumb.dataset.index, 10);
    var img = document.getElementById('av-main-img');
    if (!img || !src) return;
    img.removeAttribute('srcset'); /* Force browser to use the new src */
    img.src = src;
    img.setAttribute('data-full-src', fullSrc);
    window.avCurrentIndex = index;
    /* highlight active thumb */
    document.querySelectorAll('.av-gallery__thumb').forEach(function(t) {
      t.classList.remove('av-gallery__thumb--active');
    });
    thumb.classList.add('av-gallery__thumb--active');
  }

  function avOpenLightbox(index) {
    window.avLbIndex = typeof index !== 'undefined' ? index : (window.avCurrentIndex || 0);
    avUpdateLightbox();
    var lb = document.getElementById('av-lightbox');
    if (lb) lb.classList.add('av-lightbox--open');
    document.body.style.overflow = 'hidden';
  }

  function avUpdateLightbox() {
    var src = window.avProductMedias[window.avLbIndex];
    if (!src) return;
    var lbImg = document.getElementById('av-lightbox-img');
    if (lbImg) lbImg.src = src;
    
    var currentEl = document.getElementById('av-lb-current');
    if (currentEl) currentEl.innerText = window.avLbIndex + 1;
    var totalEl = document.getElementById('av-lb-total');
    if (totalEl) totalEl.innerText = window.avProductMedias.length;
  }

  function avPrevImage() {
    if (window.avLbIndex > 0) {
      window.avLbIndex--;
    } else {
      window.avLbIndex = window.avProductMedias.length - 1;
    }
    avUpdateLightbox();
  }

  function avNextImage() {
    if (window.avLbIndex < window.avProductMedias.length - 1) {
      window.avLbIndex++;
    } else {
      window.avLbIndex = 0;
    }
    avUpdateLightbox();
  }

  function avCloseLightbox() {
    var lb = document.getElementById('av-lightbox');
    if (!lb) return;
    lb.classList.remove('av-lightbox--open');
    document.body.style.overflow = '';
  }

  document.addEventListener('keydown', function(e) {
    var lb = document.getElementById('av-lightbox');
    if (lb && lb.classList.contains('av-lightbox--open')) {
      if (e.key === 'Escape') avCloseLightbox();
      if (e.key === 'ArrowLeft') avPrevImage();
      if (e.key === 'ArrowRight') avNextImage();
    }
  });
</script>

<!-- Lightbox overlay -->
<style>
  #av-lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999999;
    background: #ffffff;
    flex-direction: column;
  }
  #av-lightbox.av-lightbox--open { display: flex; }
  .av-lb-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 32px;
    flex-shrink: 0;
  }
  .av-lb-counter {
    border: 1px solid #E5E5E5;
    border-radius: 20px;
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 500;
    color: #141414;
  }
  .av-lb-close {
    width: 48px;
    height: 48px;
    border: 1px solid #E5E5E5;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #141414;
    transition: background 0.2s;
  }
  .av-lb-close:hover, .av-lb-nav:hover { background: #f7f7f7; }
  .av-lb-content {
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    position: relative;
    min-height: 0;
  }
  .av-lb-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border: 1px solid #E5E5E5;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #141414;
    transition: background 0.2s;
    z-index: 10;
  }
  .av-lb-prev { left: 40px; }
  .av-lb-next { right: 40px; }
  #av-lightbox-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    min-height: 0;
    min-width: 0;
    animation: avLbIn 0.25s ease;
  }
  @keyframes avLbIn {
    from { transform: scale(0.96); opacity: 0; }
    to   { transform: scale(1);    opacity: 1; }
  }
  @media (max-width: 768px) {
    .av-lb-header { padding: 16px; }
    .av-lb-prev { left: 16px; }
    .av-lb-next { right: 16px; }
    .av-lb-nav { width: 40px; height: 40px; }
    .av-lb-close { width: 40px; height: 40px; }
  }

  .av-gallery__thumb--active {
    outline: 2px solid rgb(20,20,20);
    outline-offset: 2px;
    border-radius: 22px;
  }
</style>

<div id="av-lightbox">
  <div class="av-lb-header">
    <div class="av-lb-counter"><span id="av-lb-current">1</span> / <span id="av-lb-total">1</span></div>
    <button class="av-lb-close" onclick="avCloseLightbox()" aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
  <div class="av-lb-content" onclick="if(event.target===this)avCloseLightbox()">
    <button class="av-lb-nav av-lb-prev" onclick="avPrevImage()" aria-label="Previous">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <img id="av-lightbox-img" src="" alt="Product view">
    <button class="av-lb-nav av-lb-next" onclick="avNextImage()" aria-label="Next">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</div>


