{% comment %}
  Swarakshit Main Product Section
  Pixel-perfect replica of Airvalent Elegance layout.

  Gallery layout (from Airvalent computed styles at 1440px):
  - Outer product: CSS grid, LEFT col (auto/1fr) + RIGHT col (382px)
  - Gallery inner: CSS grid, cols = 563px + 310px, gap = 20px
  - Main image: 563px wide × natural height (auto), object-fit: cover
  - Thumbnails: 310×310px FIXED SQUARE each, stacked in right col

  Right info panel:
  - sticky, top: 120px
  - vendor (text-base), title+price (side by side), description,
    inventory (stock text + gradient progress bar::before), 
    qty+ATC form, payment button (separate form), 
    more payment options, share row, trust items (4)
{% endcomment %}

{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

<style>
html {
  scroll-behavior: smooth;
  overflow-x: hidden;
}
body {
  overflow-x: hidden;
  max-width: 100vw;
}
/* ──────────────────────────────────────────────────────────
   BASE — font, wrapper, reset
   ────────────────────────────────────────────────────────── */
.av-wrap * {
  box-sizing: border-box;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
}

.av-wrap {
  width: 100%;
  background: #fff;
  color: rgb(20, 20, 20);
  margin-top: {{ section.settings.margin_top }}px;
  margin-bottom: {{ section.settings.margin_bottom }}px;
}

.av-product > * {
  min-width: 0;
}

/* ──────────────────────────────────────────────────────────
   OUTER PRODUCT GRID
   Desktop: LEFT (auto) + RIGHT (382px gap-5)
   Mobile: single column
   ────────────────────────────────────────────────────────── */
.av-product {
  display: flex;
  flex-direction: column;
  gap: 2rem;
  width: 100%;
  padding: 1.5rem;
  margin: 0 auto;
  max-width: 1440px;
}

@media (min-width: 1024px) {
  .av-product {
    display: grid;
    grid-template-columns: minmax(0, 58%) minmax(26rem, 42%);
    gap: clamp(1rem, 1.6vw, 1.5rem);
    align-items: flex-start;
    padding: 0 1.5rem 2rem;
  }
}

/* ──────────────────────────────────────────────────────────
   LEFT: GALLERY
   Inner CSS grid: 2 cols — main (auto/1fr) + thumbs (310px)
   On mobile: single col, thumbs wrap horizontal
   ────────────────────────────────────────────────────────── */
.av-gallery {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  width: 100%;
  min-width: 0;
}

@media (min-width: 1024px) {
  .av-gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(10rem, 18vw, 14rem);
    grid-template-rows: auto;
    gap: 1rem;
    align-items: flex-start;
  }
}

/* MAIN IMAGE — left cell, bounded height matching Airvalent ~505px */
.av-gallery__main {
  width: 100%;
  background: transparent;
  border: none;
  border-radius: 24px;
  box-shadow: none;
  overflow: hidden;
  grid-row: 1;
  grid-column: 1;
  height: clamp(30rem, 55vw, 56rem);
  display: flex;
  align-items: center;
  justify-content: center;
}

.av-gallery__main img {
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: 100%;
  object-fit: contain;
  object-position: center center;
  padding: clamp(3rem, 4.6vw, 4.5rem) clamp(1.2rem, 1.8vw, 1.6rem) clamp(1.2rem, 1.8vw, 1.6rem);
  margin: 0 auto;
  display: block;
}

/* On mobile: fixed height */
@media (max-width: 1023px) {
  .av-gallery__main {
    height: 480px;
  }
  .av-gallery__main img {
    object-fit: contain;
    object-position: center center;
    padding: 2.25rem 1rem 1rem;
  }
}

/* THUMB COLUMN — right cell */
.av-gallery__thumbs {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  grid-row: 1;
  grid-column: 2;
}

@media (max-width: 1023px) {
  .av-gallery__thumbs {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
}

/* Each thumb is a FIXED 310×310 square — exact Airvalent spec */
.av-gallery__thumb {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 22px;
  overflow: hidden;
  background: transparent;
  border: none;
  box-shadow: none;
  cursor: pointer;
  transition: opacity 0.2s;
  flex-shrink: 0;
}

.av-gallery__thumb:hover { opacity: 0.85; }

.av-gallery__thumb img {
  width: auto;
  max-width: 100%;
  height: auto;
  max-height: 100%;
  object-fit: contain;
  object-position: center center;
  padding: 1.4rem 0.85rem 0.85rem;
  margin: 0 auto;
  display: block;
}

@media (max-width: 1023px) {
  .av-gallery__thumb {
    width: calc(50% - 0.375rem);
    aspect-ratio: 1 / 1;
  }
  .av-gallery__thumb img {
    object-fit: contain;
    object-position: center center;
    padding: 1.1rem 0.75rem 0.75rem;
  }
}

/* ──────────────────────────────────────────────────────────
   RIGHT: INFO PANEL
   Matches Airvalent flex-col layout
   ────────────────────────────────────────────────────────── */
.av-info {
  width: 100%;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-top: 0;
  padding-top: 0;
}

/* ── Vendor ──────────────── */
.av-info__vendor {
  font-size: 16px;
  font-weight: 400;
  line-height: 25.6px;
  letter-spacing: normal;
  color: rgb(20, 20, 20);
  margin-bottom: 1rem;
}

/* ── Title + Price — stacked vertically ─── */
.av-info__head {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-bottom: 0.75rem;
}

.av-info__title {
  font-size: clamp(2.4rem, 2.2vw, 3.2rem);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -1.2px;
  color: rgb(20, 20, 20);
  margin: 0;
  overflow-wrap: anywhere;
}

.av-info__price {
  font-size: 2rem;
  font-weight: 600;
  line-height: normal;
  letter-spacing: normal;
  color: rgb(20, 20, 20);
  white-space: nowrap;
  padding-top: 0;
}

/* ── Description ───────────── */
.av-info__desc {
  font-size: 16px;
  font-weight: 400;
  line-height: 25.6px;
  letter-spacing: normal;
  color: rgb(20, 20, 20);
  margin-bottom: 1.5rem;
  opacity: 0.85;
}

.av-info__actions {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.25rem;
}


/* Quantity pill — Airvalent: 1px border rgba(20,20,20,0.1), radius 60px, h 52px */
.av-info__qty {
  display: flex;
  align-items: center;
  border: 1px solid rgba(20, 20, 20, 0.1);
  border-radius: 60px;
  height: 56px;
  min-width: 120px;
  background: #fff;
  flex-shrink: 0;
  overflow: hidden;
}

.av-info__qty-btn {
  width: 42px;
  height: 56px;
  background: transparent;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: inherit;
  font-size: 1.4rem;
  color: rgb(20, 20, 20);
  transition: opacity 0.15s;
  padding: 0;
  -webkit-tap-highlight-color: transparent;
}

.av-info__qty-btn:hover { opacity: 0.5; }

.av-info__qty-input {
  flex: 1;
  height: 56px;
  border: none;
  text-align: center;
  font-size: 1.125rem;
  font-weight: 500;
  font-family: inherit;
  color: rgb(20, 20, 20);
  background: transparent;
  -moz-appearance: textfield;
  padding: 0;
  min-width: 28px;
}

.av-info__qty-input::-webkit-outer-spin-button,
.av-info__qty-input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

/* ATC button — exact Airvalent: 15.2693px, weight 700, white */
.av-info__atc {
  flex: 1;
  height: 56px;
  min-height: 56px;
  background: rgb(20, 20, 20);
  color: #fff;
  border: none;
  border-radius: 60px;
  font-size: 16px;
  font-weight: 700;
  line-height: normal;
  letter-spacing: normal;
  font-family: inherit;
  cursor: pointer;
  transition: background 0.2s, transform 0.1s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  white-space: nowrap;
  padding: 0 1.5rem;
}

.av-info__atc:hover:not(:disabled) {
  background: rgb(40, 40, 40);
}

.av-info__atc:active:not(:disabled) {
  transform: scale(0.98);
}

.av-info__atc:disabled {
  background: rgba(20, 20, 20, 0.35);
  cursor: not-allowed;
}

@media screen and (max-width: 768px) {
  .av-info__actions {
    flex-direction: column;
    align-items: stretch;
  }
  .av-info__qty {
    width: auto;
    justify-content: center;
    box-sizing: border-box;
  }
  .av-info__atc {
    width: auto;
    flex: none;
    box-sizing: border-box;
  }
}

/* ── Payment button — own form to fix hover-bleed bug ── */
.av-info__payment {
  margin-bottom: 1.75rem;
  position: relative;
  isolation: isolate;
  z-index: 0;
  overflow: hidden;
  border-radius: 60px;
}

.av-info__payment .shopify-payment-button__button {
  border-radius: 60px !important;
  font-family: 'Inter', sans-serif !important;
  font-weight: 700 !important;
  min-height: 56px !important;
  font-size: 16px !important;
  background-color: #E87722 !important;
  color: #ffffff !important;
}

.av-info__payment .shopify-payment-button__button:hover,
.av-info__payment .shopify-payment-button__button:focus-visible {
  background-color: #C5611A !important;
  color: #ffffff !important;
}

/* ── "More payment options" link ─── */
.av-info__more-pay {
  text-align: center;
  margin-bottom: 1.4rem;
}

.av-info__more-pay a {
  font-size: 14px;
  font-weight: 400;
  line-height: 17.5px;
  letter-spacing: normal;
  color: rgb(20, 20, 20);
  text-decoration: underline;
  text-underline-offset: 2px;
  opacity: 0.8;
  transition: opacity 0.15s;
}

.av-info__more-pay a:hover { opacity: 1; }

/* ── Share row — exact Airvalent ─── */
.av-info__share {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 2rem;
  font-size: 18px;
  font-weight: 400;
  line-height: 18px;
  letter-spacing: normal;
  color: rgb(20, 20, 20);
}

.av-info__share-label { flex-shrink: 0; }

.av-info__share-icons {
  display: flex;
  gap: 0.1rem;
  align-items: center;
}

.av-info__share-icons a {
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgb(20, 20, 20);
  width: 38px;
  height: 38px;
  border-radius: 50%;
  transition: background 0.15s;
  -webkit-tap-highlight-color: transparent;
}

.av-info__share-icons a:hover {
  background: rgba(20, 20, 20, 0.06);
}

.av-info__share-icons svg {
  width: 18px;
  height: 18px;
  display: block;
}

.av-info__need-help {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 1.125rem;
  font-weight: 500;
  color: rgb(20, 20, 20);
  text-decoration: none;
  white-space: nowrap;
  opacity: 0.9;
  transition: opacity 0.15s;
}

.av-info__need-help:hover { opacity: 1; }

.av-info__need-help svg {
  width: 18px;
  height: 18px;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.5;
  flex-shrink: 0;
}

/* ── Trust items — Airvalent style: no card, just stacked divs with icon+text ── */
.av-info__trust {
  display: flex;
  flex-direction: column;
  gap: 0;
  margin-bottom: 1.5rem;
}

.av-info__trust-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1rem 1.25rem;
  font-size: 14px;
  font-weight: 400;
  line-height: 17.5px;
  letter-spacing: normal;
  color: rgb(20, 20, 20);
  background: rgb(var(--color-background, 248 248 248));
  border-radius: 16px;
  margin-bottom: 0.5rem;
}

.av-info__trust-item:last-child { margin-bottom: 0; }

.av-info__trust-item svg {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  stroke: rgb(20, 20, 20);
  fill: none;
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
  opacity: 0.7;
}

/* ── Accordions ─────────────────── */
.av-info__accordions {
  border-top: 1px solid rgba(20, 20, 20, 0.1);
}

.av-info__accordion {
  border-bottom: 1px solid rgba(20, 20, 20, 0.1);
}

.av-info__accordion summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.1rem 0;
  cursor: pointer;
  font-size: 0.9375rem;
  font-weight: 500;
  color: rgb(20, 20, 20);
  list-style: none;
  user-select: none;
  -webkit-user-select: none;
  gap: 1rem;
}

.av-info__accordion summary::-webkit-details-marker { display: none; }

.av-info__accordion-icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  position: relative;
}

.av-info__accordion-icon::before,
.av-info__accordion-icon::after {
  content: '';
  position: absolute;
  background: rgb(20, 20, 20);
  transition: transform 0.25s ease, opacity 0.2s ease;
}

.av-info__accordion-icon::before {
  top: 7px; left: 0;
  width: 16px; height: 1.5px;
}

.av-info__accordion-icon::after {
  top: 0; left: 7px;
  width: 1.5px; height: 16px;
}

details[open].av-info__accordion .av-info__accordion-icon::after {
  transform: rotate(90deg);
  opacity: 0;
}

.av-info__accordion-body {
  padding-bottom: 1.25rem;
  font-size: 0.875rem;
  line-height: 1.65;
  color: rgba(20, 20, 20, 0.65);
}

.av-info__accordion-body p { margin: 0 0 0.5rem; }
.av-info__accordion-body p:last-child { margin-bottom: 0; }

/* ── Responsive ─── */
@media (max-width: 1023px) {
  .av-info {
    position: static;
  }
}

@media (min-width: 1024px) and (max-width: 1320px) {
  .av-info__vendor {
    margin-bottom: 0.75rem;
  }

  .av-info__head {
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .av-info__price {
    font-size: 1.9rem;
    padding-top: 0.2rem;
  }

  .av-info__desc {
    font-size: 1.05rem;
    line-height: 1.55;
    margin-bottom: 1.35rem;
  }

  .av-info__actions {
    gap: 0.625rem;
  }

  .av-info__qty,
  .av-info__atc,
  .av-info__payment .shopify-payment-button__button {
    height: 52px;
    min-height: 52px !important;
  }

  .av-info__qty-btn,
  .av-info__qty-input {
    height: 52px;
  }

  .av-info__atc {
    font-size: 15px;
    padding: 0 1.2rem;
  }
}
</style>

<div class="av-wrap">
  <div class="av-product">

    {%- comment -%}━━━━ LEFT: GALLERY ━━━━{%- endcomment -%}
    <div class="av-gallery">

      {%- assign first_img = product.media | first -%}

      {%- comment -%} Main large image — click to open lightbox {%- endcomment -%}
      <div class="av-gallery__main" id="av-main-wrap" onclick="avOpenLightbox(window.avCurrentIndex || 0)" style="cursor:zoom-in;">
        {%- if first_img.media_type == 'image' -%}
          <img
            id="av-main-img"
            src="{{ first_img | image_url: width: 1400 }}"
            srcset="{{ first_img | image_url: width: 600 }} 600w, {{ first_img | image_url: width: 1000 }} 1000w, {{ first_img | image_url: width: 1400 }} 1400w"
            sizes="(min-width: 1024px) 55vw, 100vw"
            alt="{{ first_img.preview_image.alt | escape }}"
            loading="eager"
            width="{{ first_img.preview_image.width }}"
            height="{{ first_img.preview_image.height }}"
            data-full-src="{{ first_img | image_url: width: 2048 }}"
          >
        {%- elsif first_img.media_type == 'video' -%}
          {{ first_img | media_tag }}
        {%- endif -%}
      </div>

      {%- comment -%} Thumbnail column — click updates main image + highlights active thumb {%- endcomment -%}
      {%- if product.media.size > 1 -%}
        <div class="av-gallery__thumbs">
          {%- for media in product.media offset: 1 -%}
            {%- if media.media_type == 'image' -%}
              <div
                class="av-gallery__thumb"
                data-src="{{ media | image_url: width: 1400 }}"
                data-full="{{ media | image_url: width: 2048 }}"
                data-index="{{ forloop.index }}"
                onclick="avSetMain(this)"
                aria-label="{{ media.preview_image.alt | escape }}"
              >
                <img
                  src="{{ media | image_url: width: 400 }}"
                  srcset="{{ media | image_url: width: 250 }} 250w, {{ media | image_url: width: 400 }} 400w"
                  sizes="(min-width: 768px) 310px, 50vw"
                  alt="{{ media.preview_image.alt | escape }}"
                  loading="lazy"
                  width="{{ media.preview_image.width }}"
                  height="{{ media.preview_image.height }}"
                >
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
    {%- comment -%}━━━━ /GALLERY ━━━━{%- endcomment -%}

    {%- comment -%}━━━━ RIGHT: INFO PANEL ━━━━{%- endcomment -%}
    <div class="av-info">

      {%- comment -%} Vendor / brand — split on pipe to show only the brand name {%- endcomment -%}
      {%- assign vendor_parts = shop.name | split: ' | ' -%}
      <div class="av-info__vendor">{{ vendor_parts[0] }}</div>

      {%- comment -%} Title + Price — 2-col grid exactly like Airvalent {%- endcomment -%}
      <div class="av-info__head">
        <h1 class="av-info__title">{{ product.title }}</h1>
        <div class="av-info__price">{{ product.price | money }}</div>
      </div>

      <div class="av-info__reviews" aria-label="Customer reviews summary">
        <!-- Start of Judge.me code -->
        <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
          {{ product.metafields.judgeme.badge }}
        </div>
        <!-- End of Judge.me code -->
      </div>

      {%- comment -%} Short description from product {%- endcomment -%}
      <div class="av-info__desc">
        {%- if product.metafields.custom.short_description != blank -%}
          {{ product.metafields.custom.short_description | metafield_tag }}
        {%- elsif product.description != blank -%}
          {{ product.description | strip_html | truncatewords: 25 }}
        {%- else -%}
          Portable · Instant Alert · Multi-Gas Detection
        {%- endif -%}
      </div>


      {%- comment -%}
        PRODUCT FORM — qty + Add to Cart ONLY.
        Payment button is a SEPARATE form below to prevent
        Shopify's dynamic checkout overlay from intercepting
        hover events over the whole right panel.
      {%- endcomment -%}
      {%- form 'product', product, id: 'av-product-form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="av-info__actions">

          {%- comment -%} Quantity picker {%- endcomment -%}
          <div class="av-info__qty">
            <button
              type="button"
              class="av-info__qty-btn"
              aria-label="Decrease quantity"
              onclick="(function(btn){var i=btn.closest('.av-info__qty').querySelector('input');if(parseInt(i.value)>1){i.value=parseInt(i.value)-1;syncPayQty(i.value);}})(this)"
            >
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 6H3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
            <input
              class="av-info__qty-input"
              type="number"
              id="av-qty"
              name="quantity"
              min="1"
              value="1"
              aria-label="Quantity"
            >
            <button
              type="button"
              class="av-info__qty-btn"
              aria-label="Increase quantity"
              onclick="(function(btn){var i=btn.closest('.av-info__qty').querySelector('input');i.value=parseInt(i.value)+1;syncPayQty(i.value);})(this)"
            >
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 3v6M9 6H3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </button>
          </div>

          {%- comment -%} Add to cart button {%- endcomment -%}
          <button
            type="submit"
            name="add"
            id="av-atc"
            class="av-info__atc"
            {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
          >
            {%- if product.selected_or_first_available_variant.available -%}
              Add to cart&nbsp;&nbsp;&dash;&nbsp;&nbsp;{{ product.price | money }}
            {%- else -%}
              Sold out
            {%- endif -%}
          </button>

        </div>
      {%- endform -%}

      {%- comment -%}
        PAYMENT BUTTON — separate form.
        Shopify's dynamic checkout button renders a position:absolute overlay
        that covers its parent form; keeping it in its own form prevents hover-
        bleed over the qty/ATC row.
      {%- endcomment -%}
      <div class="av-info__payment">
        {%- form 'product', product, id: 'av-pay-form' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" id="av-pay-qty" value="1">
          {{ form | payment_button }}
        {%- endform -%}
      </div>



      {%- comment -%} Share + Need help {%- endcomment -%}
      <div class="av-info__share">
        <span class="av-info__share-label">Share:</span>
        <div class="av-info__share-icons">
          <a href="https://wa.me/?text={{ product.title | url_encode }}%20{{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener" aria-label="Share on WhatsApp">
