<style>
  .svarakshit-use-cases-wrapper {
    padding-top: 60px;
    padding-bottom: 60px;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding-left: 5rem;
    padding-right: 5rem;
    box-sizing: border-box;
  }

  @media screen and (max-width: 989px) {
    .svarakshit-use-cases-wrapper {
      padding-left: 2rem;
      padding-right: 2rem;
    }
  }

  .svarakshit-use-cases-layout {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media (min-width: 990px) {
    .svarakshit-use-cases-layout {
      flex-direction: row;
      align-items: center;
    }
    .svarakshit-use-cases-text-col {
      flex: 0 0 calc(35% - 20px);
      padding-right: 40px;
      position: sticky;
      top: 40px;
    }
    .svarakshit-use-cases-slider-col {
      flex: 0 0 calc(65% - 20px);
      overflow: hidden;
    }
  }

  .svarakshit-use-cases-heading {
    font-size: 3.5rem;
    font-weight: 800;
    margin: 0 0 16px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: #111111;
  }

  .svarakshit-use-cases-desc {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #333;
  }

  .svarakshit-use-cases-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 280px;
    gap: 20px;
    width: 100%;
  }

  @media screen and (max-width: 989px) {
    .svarakshit-use-cases-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 240px;
    }
    /* Cancel bento span on mobile — all cards same height */
    .svarakshit-uc-card--tall,
    .svarakshit-uc-card--small {
      grid-row: span 1;
    }
  }

  @media (max-width: 989px) {
    .svarakshit-use-cases-heading {
      font-size: 2.5rem;
    }
  }

  .svarakshit-uc-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    cursor: pointer;
  }

  .svarakshit-uc-card--tall {
    grid-row: span 2;
  }

  .svarakshit-uc-card--small {
    grid-row: span 1;
  }

  .svarakshit-uc-card__bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    background-color: #f0f0f0;
  }

  .svarakshit-uc-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .svarakshit-uc-card:hover .svarakshit-uc-card__img {
    transform: scale(1.05);
  }

  .svarakshit-uc-card__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 60%;
    background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
    z-index: 2;
    pointer-events: none;
  }

  .svarakshit-uc-card__content {
    position: relative;
    z-index: 3;
    padding: 24px;
    color: #fff;
  }

  .svarakshit-uc-card__subtitle {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
    opacity: 0.9;
  }

  .svarakshit-uc-card__title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .svarakshit-uc-card__title-wrap {
    position: relative;
    display: inline-block;
  }

  .svarakshit-uc-card__title {
    font-family: 'Inter', sans-serif;
    font-size: 24px;
    font-weight: 700;
    margin: 0;
    color: #fff;
    letter-spacing: -0.5px;
  }

  .svarakshit-uc-card__title-wrap::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 0;
    height: 2px;
    background-color: #fff;
    transition: width 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .svarakshit-uc-card:hover .svarakshit-uc-card__title-wrap::after {
    width: 100%;
  }

</style>

<div class="svarakshit-use-cases-wrapper">
  <div class="svarakshit-use-cases-layout">
    
    <div class="svarakshit-use-cases-text-col">
      <h2 class="svarakshit-use-cases-heading">{{ section.settings.heading }}</h2>
      <div class="svarakshit-use-cases-desc">{{ section.settings.text }}</div>
    </div>

    <div class="svarakshit-use-cases-slider-col">
      <div class="svarakshit-use-cases-grid">
        {% for block in section.blocks %}
          <a href="{{ block.settings.link | default: '#' }}" class="svarakshit-uc-card svarakshit-uc-card--{{ block.settings.size }}" {{ block.shopify_attributes }}>
            <div class="svarakshit-uc-card__bg">
              {% if block.settings.image %}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ block.settings.title | escape }}"
                  class="svarakshit-uc-card__img"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% else %}
                {% render 'svarakshit-fallback-image',
                  context: block.settings.title,
                  alt: block.settings.title,
                  class: 'svarakshit-uc-card__img',
                  loading: 'lazy'
                %}
              {% endif %}
            </div>
            <div class="svarakshit-uc-card__overlay"></div>
            <div class="svarakshit-uc-card__content">
              {% if block.settings.subtitle != blank %}
                <div class="svarakshit-uc-card__subtitle">{{ block.settings.subtitle }}</div>
              {% endif %}
              <div class="svarakshit-uc-card__title-row">
                <div class="svarakshit-uc-card__title-wrap">
                  <h3 class="svarakshit-uc-card__title">{{ block.settings.title }}</h3>
                </div>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
    
  </div>
</div>

{% schema %}
{
  "name": "Our Use Cases",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Use Cases"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>Discover the vital applications for our advanced gas sensors. From everyday household safety to rigorous industrial monitoring, ensure peace of mind with reliable, real-time leak detection.</p>"
    }
  ],
  "blocks": [
    {
      "type": "use_case",
      "name": "Use Case",
      "settings": [
        {
          "type": "select",
          "id": "size",
          "label": "Card Size",
          "options": [
            { "value": "tall", "label": "Tall (Full Height)" },
            { "value": "small", "label": "Small (Half Height)" }
          ],
          "default": "tall"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle (Top Text)",
          "default": "SWARAKSHIT"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Industrial Safety"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Use Cases",
      "blocks": [
        { "type": "use_case", "settings": { "size": "tall", "title": "Industrial Plants" } },
        { "type": "use_case", "settings": { "size": "small", "title": "Home Kitchens" } },
        { "type": "use_case", "settings": { "size": "small", "title": "Basements" } },
        { "type": "use_case", "settings": { "size": "tall", "title": "Commercial Offices" } }
      ]
    }
  ]
}
{% endschema %}
