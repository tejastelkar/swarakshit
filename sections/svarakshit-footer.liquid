<style>
  .svarakshit-footer {
    background-color: #1c1c1c;
    color: #ffffff;
    padding: 100px 5rem 40px;
    position: relative;
    z-index: 0;
    font-family: 'Inter', sans-serif;
  }

  .svarakshit-footer-top {
    display: grid;
    grid-template-columns: minmax(280px, 1.2fr) 3fr;
    gap: 80px;
    margin-bottom: 80px;
  }

  /* Left column: Logo + Socials */
  .svarakshit-footer-left {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .svarakshit-footer-logo {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #ffffff;
    text-decoration: none;
    text-transform: uppercase;
  }

  .svarakshit-footer-socials {
    display: flex;
    gap: 20px;
  }

  .svarakshit-footer-social-icon {
    width: 24px;
    height: 24px;
    color: #ffffff;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }
  
  .svarakshit-footer-social-icon:hover {
    opacity: 1;
  }

  /* Right Columns: Menus & Contact Info */
  .svarakshit-footer-menus {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 40px;
  }

  .svarakshit-footer-block {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 150px;
  }

  .svarakshit-footer-block h4 {
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
    margin: 0;
  }

  .svarakshit-footer-menu ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .svarakshit-footer-menu a {
    color: #ffffff;
    text-decoration: none;
    opacity: 0.7;
    font-size: 15px;
    transition: opacity 0.3s ease;
  }

  .svarakshit-footer-menu a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .svarakshit-footer-contact-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .svarakshit-footer-contact-text p {
    margin: 0;
    font-size: 15px;
    color: #ffffff;
    opacity: 0.7;
    line-height: 1.5;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .svarakshit-footer-contact-text p svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    opacity: 0.8;
  }

  .svarakshit-footer-contact-text p a {
    color: #ffffff;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .svarakshit-footer-contact-text p a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 4px;
  }


  /* Bottom Strip */
  .svarakshit-footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 30px;
  }

  .svarakshit-footer-bottom-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 30px;
  }

  .svarakshit-footer-copyright {
    color: #ffffff;
    opacity: 0.6;
    font-size: 13px;
    margin: 0;
  }
  
  .svarakshit-footer-copyright a {
    color: #ffffff;
    text-decoration: none;
  }
  
  .svarakshit-footer-copyright a:hover {
    text-decoration: underline;
  }

  .svarakshit-footer-policies {
    display: flex;
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .svarakshit-footer-policies a {
    color: #ffffff;
    opacity: 0.6;
    font-size: 13px;
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .svarakshit-footer-policies a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  .svarakshit-footer-payments {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }

  .svarakshit-footer-payment-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .svarakshit-footer-payment-icon svg {
    height: 24px;
    width: auto;
  }
  
  .svarakshit-footer-payment-icon-custom {
    height: 24px;
    background-color: #ffffff;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
  }
  
  .svarakshit-footer-payment-icon-custom img {
    height: 14px;
    width: auto;
    object-fit: contain;
  }

  @media screen and (min-width: 769px) and (max-width: 989px) {
    .svarakshit-footer {
      padding: 80px 3rem 30px;
    }
    .svarakshit-footer-menus {
      gap: 40px;
    }
  }

  @media (max-width: 768px) {
    .svarakshit-footer {
      padding: 60px 2rem 30px;
    }
    .svarakshit-footer-top {
      grid-template-columns: 1fr;
      gap: 40px;
      margin-bottom: 60px;
    }
    .svarakshit-footer-menus {
      grid-template-columns: 1fr;
      gap: 40px;
      width: 100%;
    }
    .svarakshit-footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
    .svarakshit-footer-bottom-left {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .svarakshit-footer-policies {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>

<div class="svarakshit-footer">
  <div class="svarakshit-footer-top">
    <!-- Left Column: Logo & Socials -->
    <div class="svarakshit-footer-left">
      {% if section.settings.logo %}
        <img
          src="{{ section.settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name | escape }}"
          style="max-width: 200px;"
          loading="lazy"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
        >
      {% else %}
        {% if section.settings.logo_text != blank %}
          <a href="{{ routes.root_url }}" class="svarakshit-footer-logo">{{ section.settings.logo_text }}</a>
        {% endif %}
      {% endif %}

      <div class="svarakshit-footer-socials">
        {%- if section.settings.social_facebook != blank -%}
        <a href="{{ section.settings.social_facebook }}" class="svarakshit-footer-social-icon" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_twitter != blank -%}
        <a href="{{ section.settings.social_twitter }}" class="svarakshit-footer-social-icon" target="_blank" rel="noopener noreferrer" aria-label="Follow us on X (Twitter)">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_instagram != blank -%}
        <a href="{{ section.settings.social_instagram }}" class="svarakshit-footer-social-icon" target="_blank" rel="noopener noreferrer" aria-label="Follow us on Instagram">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.social_youtube != blank -%}
        <a href="{{ section.settings.social_youtube }}" class="svarakshit-footer-social-icon" target="_blank" rel="noopener noreferrer" aria-label="Follow us on YouTube">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 00-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.016 3.016 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        {%- endif -%}
      </div>
    </div>

    <!-- Right Columns: Blocks -->
    <div class="svarakshit-footer-menus">
      {% for block in section.blocks %}
        {% if block.type == 'link_list' %}
          <div class="svarakshit-footer-block svarakshit-footer-menu" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            {% if block.settings.menu != blank %}
              <ul>
                {% for link in linklists[block.settings.menu].links %}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {% endfor %}
              </ul>
            {% endif %}
          </div>
        {% elsif block.type == 'contact_info' %}
          <div class="svarakshit-footer-block" {{ block.shopify_attributes }}>
            {% if block.settings.heading != blank %}
              <h4>{{ block.settings.heading }}</h4>
            {% endif %}
            {% if block.settings.text != blank %}
              <div class="svarakshit-footer-contact-text">
                {% assign contact_lines = block.settings.text | newline_to_br | split: '<br />' %}
                {% for line in contact_lines %}
                  {% assign clean_line = line | strip %}
                  {% if clean_line != blank %}
                    <p>
                      {% if clean_line contains '@' %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        <a href="mailto:{{ clean_line }}">{{ clean_line }}</a>
                      {% else %}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        {% assign tel_number = clean_line | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' %}
                        <a href="tel:{{ tel_number }}">{{ clean_line }}</a>
                      {% endif %}
                    </p>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="svarakshit-footer-bottom">
    <div class="svarakshit-footer-bottom-left">
      <p class="svarakshit-footer-copyright">
        &copy; {{ 'now' | date: "%Y" }} {{ shop.name }}. <a href="https://www.shopify.com" target="_blank" rel="nofollow">Powered by Shopify</a>
      </p>

      <ul class="svarakshit-footer-policies">
        <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
        <li><a href="/policies/refund-policy">Refund Policy</a></li>
        <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
        <li><a href="/policies/terms-of-service">Terms of Service</a></li>
        <li><a href="/pages/contact">Contact information</a></li>
      </ul>
    </div>
    
    <div class="svarakshit-footer-payments">
      <div class="svarakshit-footer-payment-icon">
        {{ 'visa' | payment_type_svg_tag }}
      </div>
      <div class="svarakshit-footer-payment-icon">
        {{ 'master' | payment_type_svg_tag }}
      </div>
      <div class="svarakshit-footer-payment-icon-custom">
        <img src="{{ 'rupay-logo.svg' | asset_url }}" alt="RuPay" width="38" height="24" loading="lazy">
      </div>
      <div class="svarakshit-footer-payment-icon-custom">
        <img src="{{ 'upi-logo.svg' | asset_url }}" alt="UPI" width="38" height="24" loading="lazy">
      </div>
      <div class="svarakshit-footer-payment-icon-custom">
        <img src="{{ 'razorpay-logo.svg' | asset_url }}" alt="Razorpay" width="80" height="24" loading="lazy">
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Swarakshit Footer",
  "tag": "footer",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "SWARAKSHIT"
    },
    {
      "type": "header",
      "content": "Social Media Links"
    },
    {
      "type": "url",
      "id": "social_facebook",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "X (Twitter) URL"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Quick links",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        }
      ]
    },
    {
      "type": "contact_info",
      "name": "Contact Info",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Contact",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Contact Details",
          "default": "(+91) 98765 43210\nsupport@swarakshit.com"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Swarakshit Footer",
      "blocks": [
        {
          "type": "link_list",
          "settings": {
            "heading": "Quick links",
            "menu": "footer"
          }
        },
        {
          "type": "link_list",
          "settings": {
            "heading": "Page sites",
            "menu": "main-menu"
          }
        },
        {
          "type": "contact_info",
          "settings": {
            "heading": "Contact",
            "text": "(+91) 98765 43210\nsupport@swarakshit.com"
          }
        }
      ]
    }
  ]
}
{% endschema %}
