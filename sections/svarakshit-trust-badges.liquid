{%- style -%}
  .svarakshit-trust-badges {
    background-color: transparent;
    padding: 4rem 0;
    overflow: hidden;
  }

  .svarakshit-trust-badges__container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
  }

  .trust-badge-item {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem;
    border-radius: 12px;
    background: #ffffff;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    border: 1.5px solid #1a1a1a; /* Black border box */
    box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.05);
  }

  .trust-badge-item:hover {
    transform: translateY(-3px) translateX(-2px);
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 1);
    border-color: #1a1a1a;
  }

  .trust-badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .trust-badge-icon svg {
    width: 36px;
    height: 36px;
  }

  .trust-badge-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .trust-badge-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
    line-height: 1.2;
  }

  .trust-badge-subtitle {
    font-size: 0.95rem;
    color: #555;
    margin: 0;
    font-weight: 500;
    line-height: 1.4;
  }

  @media screen and (max-width: 1024px) {
    .svarakshit-trust-badges__container {
      grid-template-columns: repeat(2, 1fr);
      padding: 0 2.5rem;
    }
  }

  @media screen and (max-width: 989px) {
    .svarakshit-trust-badges__container {
      padding: 0 1.5rem;
      gap: 1.5rem;
    }
  }

  @media screen and (max-width: 768px) {
    .svarakshit-trust-badges__container {
      padding: 0 2rem;
      gap: 1.5rem;
    }
  }

  @media screen and (max-width: 480px) {
    .svarakshit-trust-badges__container {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div class="svarakshit-trust-badges">
  <div class="svarakshit-trust-badges__container">
    {%- for block in section.blocks -%}
      <div class="trust-badge-item" {{ block.shopify_attributes }}>
        <div class="trust-badge-icon">
            {%- case block.settings.icon -%}
            {%- when 'shield-check' -%}
              <img
                src="{{ 'lerc-logo.jpeg' | asset_url }}"
                alt="LERC Logo"
                width="120"
                height="32"
                style="height: 32px; width: auto; object-fit: contain;"
                loading="lazy"
              >
            {%- when 'flag' -%}
              <svg class="flag-svg" viewBox="0 0 36 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect width="36" height="8" fill="#F98000"/>
                <rect y="8" width="36" height="8" fill="#FFFFFF"/>
                <rect y="16" width="36" height="8" fill="#008000"/>
                <circle cx="18" cy="12" r="3" fill="#000080"/>
                <circle cx="18" cy="12" r="1.5" fill="#FFFFFF"/>
              </svg>
            {%- when 'truck' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
                <path d="M15 18H9"/>
                <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/>
                <circle cx="17" cy="18" r="2"/>
                <circle cx="7" cy="18" r="2"/>
              </svg>
            {%- when 'rotate-ccw' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                <path d="M3 3v5h5"/>
              </svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="#1a1a1a" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
          {%- endcase -%}
        </div>
        <div class="trust-badge-content">
          <div class="trust-badge-title">{{ block.settings.title }}</div>
          <div class="trust-badge-subtitle">{{ block.settings.subtitle }}</div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust Badges New",
  "tag": "section",
  "class": "section",
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "shield-check",
              "label": "LERC Logo"
            },
            {
              "value": "flag",
              "label": "Indian Flag"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "rotate-ccw",
              "label": "Return"
            }
          ],
          "default": "shield-check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "LERC Approved"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Govt. Certified Safety"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges New",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "shield-check",
            "title": "LERC Approved",
            "subtitle": "Govt. Certified Safety"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "flag",
            "title": "Made in India",
            "subtitle": "Atmanirbhar Bharat"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "truck",
            "title": "Free Delivery",
            "subtitle": "Across India"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "rotate-ccw",
            "title": "30-Day Return",
            "subtitle": "No Questions Asked"
          }
        }
      ]
    }
  ]
}
{% endschema %}
