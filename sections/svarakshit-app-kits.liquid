<style>
  #shopify-section-{{ section.id }} .svarakshit-app-kits {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 6rem 2rem;
    font-family: 'Inter', sans-serif;
  }
  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .svarakshit-app-kits {
      padding: 8rem 5rem;
    }
  }

  #shopify-section-{{ section.id }} .svarakshit-app-kits__container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .svarakshit-app-kits__block {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .svarakshit-app-kits__block {
      flex-direction: row;
      gap: 8rem;
      align-items: center;
    }
    .svarakshit-app-kits__block.layout-right {
      flex-direction: row-reverse;
    }
  }

  .svarakshit-app-kits__image-wrap {
    flex: 1;
    width: 100%;
    border-radius: 36px;
    overflow: hidden;
  }

  .svarakshit-app-kits__image {
    width: 100%;
    height: 100%;
    aspect-ratio: 1064 / 764;
    display: block;
    object-fit: cover;
  }

  .svarakshit-app-kits__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 550px;
    padding-top: 2rem;
  }

  .svarakshit-app-kits__title {
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0 0 1.5rem 0;
    color: {{ section.settings.text_color }};
  }

  .svarakshit-app-kits__desc {
    font-size: 1.6rem;
    line-height: 1.6;
    margin-bottom: 3rem;
    color: #4a4a4a;
  }

  .svarakshit-app-kits__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 2.5rem;
    background-color: #1a1a1a;
    color: #ffffff;
    border-radius: 100px;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: normal;
    transition: transform 0.3s ease, background-color 0.3s ease;
    align-self: flex-start;
  }

  .svarakshit-app-kits__btn:hover {
    transform: scale(1.02);
    background-color: #000000;
  }
  
  .svarakshit-app-kits__btn svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }
  
  .svarakshit-app-kits__btn:hover svg {
    transform: translateX(4px);
  }
</style>

<div class="svarakshit-app-kits">
  <div class="svarakshit-app-kits__container">
    {% for block in section.blocks %}
      <div class="svarakshit-app-kits__block layout-{{ block.settings.layout }}" {{ block.shopify_attributes }}>
        <div class="svarakshit-app-kits__image-wrap">
          {% if block.settings.image %}
            {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'svarakshit-app-kits__image' }}
          {% else %}
            {% render 'svarakshit-fallback-image',
              context: block.settings.title,
              alt: block.settings.title,
              class: 'svarakshit-app-kits__image',
              loading: 'lazy'
            %}
          {% endif %}
        </div>
        <div class="svarakshit-app-kits__content">
          {% if block.settings.title != blank %}
            <h2 class="svarakshit-app-kits__title">{{ block.settings.title }}</h2>
          {% endif %}
          
          {% if block.settings.description != blank %}
            <div class="svarakshit-app-kits__desc">
              {{ block.settings.description }}
            </div>
          {% endif %}
          
          {% if block.settings.button_text != blank %}
            <a href="{{ block.settings.button_link | default: '#' }}" class="svarakshit-app-kits__btn">
              {{ block.settings.button_text }}
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M5 12H19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M12 5L19 12L12 19" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Application Kits",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1a1a"
    }
  ],
  "blocks": [
    {
      "type": "kit",
      "name": "Kit",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Office Kit No.1"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Built with reliable technology and sustainable, premium-quality materials.</p>"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Send a request"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Image Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Application Kits"
    }
  ]
}
{% endschema %}
