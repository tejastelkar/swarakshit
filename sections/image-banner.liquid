{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

<style>
  #Banner-{{ section.id }} {
    margin: 16px 20px 0 !important;
    border-radius: 24px !important;
    overflow: hidden !important;
    position: relative !important;
    width: calc(100% - 40px) !important;
    display: block !important;
  }
  
  @media screen and (min-width: 750px) {
    #Banner-{{ section.id }} {
      margin: 0 40px 20px !important;
      border-radius: 24px !important;
      width: calc(100% - 80px) !important;
    }
  }

  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} {
      margin: 16px 20px 0 !important;
      border-radius: 16px !important;
      width: calc(100% - 40px) !important;
      box-shadow: 0 4px 20px rgba(0,0,0,0.06) !important;
    }
  }

  /* The container needs to match the aspect ratio of the first slide on all devices */
  {%- assign first_slide = section.blocks | where: 'type', 'slide' | first -%}
  {%- if first_slide and first_slide.settings.image != blank -%}
    #Banner-{{ section.id }} {
      aspect-ratio: {{ first_slide.settings.image.aspect_ratio }} !important;
    }
  {%- else -%}
    #Banner-{{ section.id }} {
      aspect-ratio: 16 / 9 !important;
    }
  {%- endif -%}

  #Banner-{{ section.id }} .banner__slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    z-index: 1;
  }

  #Banner-{{ section.id }} .banner__slide.active {
    opacity: 1;
    visibility: visible;
    z-index: 2;
  }

  #Banner-{{ section.id }} .banner__slide img,
  #Banner-{{ section.id }} .banner__slide svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain; /* Prevents clipping */
    display: block;
  }
  
  /* Navigation Dots */
  #Banner-{{ section.id }} .banner__dots {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 10;
  }
  
  #Banner-{{ section.id }} .banner__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: background 0.3s ease;
  }
  
  #Banner-{{ section.id }} .banner__dot.active {
    background: rgba(255, 255, 255, 1);
  }
  
  .lerc-logo-overlay {
    position: absolute;
    bottom: 20px;
    right: 20px;
    width: 120px;
    height: auto;
    z-index: 10;
    pointer-events: none;
  }
  @media screen and (max-width: 749px) {
    .lerc-logo-overlay {
      width: 80px;
      bottom: 10px;
      right: 10px;
    }
  }
</style>

<div id="Banner-{{ section.id }}" class="banner-slideshow">
  <!-- LERC OMC Logo Overlay -->
  <img src="{{ 'lerc-logo.png' | file_url }}" alt="LERC Approved - IOCL, BPCL, HPCL" class="lerc-logo-overlay" onerror="this.style.display='none'">
  
  {%- for block in section.blocks -%}
    {%- if block.type == 'slide' -%}
      <div class="banner__slide {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" style="display:block; width:100%; height:100%;">
        {%- endif -%}
        
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 3840 | image_tag: loading: 'lazy', widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
        
        {%- if block.settings.link != blank -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
  
  {%- if section.blocks.size > 1 -%}
    <div class="banner__dots">
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' -%}
          <div class="banner__dot {% if forloop.first %}active{% endif %}"></div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{%- if section.blocks.size > 1 -%}
  {%- comment -%} theme-check-disable RemoteAsset {%- endcomment -%}
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js" defer="defer"></script>
  {%- comment -%} theme-check-enable RemoteAsset {%- endcomment -%}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const initSlideshow = () => {
        if (typeof gsap === 'undefined') {
          setTimeout(initSlideshow, 100);
          return;
        }

        const container = document.getElementById('Banner-{{ section.id }}');
        if (!container) return;

        const slides = container.querySelectorAll('.banner__slide');
        const dots = container.querySelectorAll('.banner__dot');
        let currentSlide = 0;
        let isAnimating = false;

        if (slides.length <= 1) return;

        // Ensure first slide is visible, others hidden
        gsap.set(slides, { autoAlpha: 0, zIndex: 1 });
        gsap.set(slides[0], { autoAlpha: 1, zIndex: 2 });

        function goToSlide(index) {
          if (isAnimating || index === currentSlide) return;
          isAnimating = true;

          const current = slides[currentSlide];
          const next = slides[index];

          // Update dots
          if(dots[currentSlide]) dots[currentSlide].classList.remove('active');
          if(dots[index]) dots[index].classList.add('active');

          // Transition
          gsap.set(next, { zIndex: 2 });
          gsap.set(current, { zIndex: 1 });
          
          gsap.to(current, {
            autoAlpha: 0,
            duration: 0.8,
            ease: "power2.inOut"
          });
          
          gsap.to(next, {
            autoAlpha: 1,
            duration: 0.8,
            ease: "power2.inOut",
            onComplete: () => {
              currentSlide = index;
              isAnimating = false;
            }
          });
        }

        function nextSlide() {
          let next = currentSlide + 1;
          if (next >= slides.length) next = 0;
          goToSlide(next);
        }

        let autoplayInterval = setInterval(nextSlide, 5000);

        // Click on dots
        dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            clearInterval(autoplayInterval);
            goToSlide(index);
            autoplayInterval = setInterval(nextSlide, 5000);
          });
        });
        
        // Pause on hover
        container.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
        container.addEventListener('mouseleave', () => {
          autoplayInterval = setInterval(nextSlide, 5000);
        });
      };

      initSlideshow();
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.image-banner.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Upload an image. The banner height will adapt to the aspect ratio of the first image."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.image-banner.presets.name",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
