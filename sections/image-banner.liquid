{{ 'section-image-banner.css' | asset_url | stylesheet_tag }}

<style>
  #Banner-{{ section.id }} {
    margin: 0 40px 20px !important;
    border-radius: 24px !important;
    overflow: hidden !important;
    position: relative !important;
    box-sizing: border-box !important;
    min-height: calc(100vh - 120px) !important;
    width: calc(100% - 80px) !important;
  }
  
  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }}::before,
    #Banner-{{ section.id }} .banner__media::before,
    #Banner-{{ section.id }} .banner__content::before {
      display: none !important;
      padding-bottom: 0 !important;
    }

    #Banner-{{ section.id }} {
      margin: 0 !important;
      border-radius: 0 !important;
      min-height: auto !important;
      width: 100% !important;
      display: flex !important;
      flex-direction: column !important;
      background: #ffffff !important;
    }
  }

  #Banner-{{ section.id }} .svarakshit-banner-slideshow {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  #Banner-{{ section.id }} .banner__slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    z-index: 0;
  }

  #Banner-{{ section.id }} .banner__slide.active {
    opacity: 1;
    z-index: 1;
  }

  #Banner-{{ section.id }} .banner__media {
    display: block !important;
    position: absolute !important;
    inset: 0 !important;
    z-index: 0 !important;
    background: transparent !important;
  }

  #Banner-{{ section.id }} .banner__media--mobile {
    display: none !important;
  }

  #Banner-{{ section.id }} .banner__media::after {
    content: '' !important;
    position: absolute !important;
    inset: 0 !important;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.82) 0%, rgba(255, 255, 255, 0.58) 36%, rgba(255, 255, 255, 0.18) 65%, rgba(255, 255, 255, 0.1) 100%) !important;
    z-index: 1 !important;
  }

  #Banner-{{ section.id }} .banner__media img,
  #Banner-{{ section.id }} .banner__media svg {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  #Banner-{{ section.id }} .banner__content {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    padding: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    z-index: 2 !important;
  }

  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} .banner__media--desktop.has-mobile-image {
      display: none !important;
    }

    #Banner-{{ section.id }} .svarakshit-banner-slideshow {
      position: relative !important;
      inset: auto !important;
      width: 100% !important;
      height: 65vw !important;
      min-height: 250px !important;
      max-height: none !important;
    }

    #Banner-{{ section.id }} .banner__slide {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
    }

    #Banner-{{ section.id }} .banner__media--desktop {
      position: absolute !important;
      inset: 0 !important;
      width: 100% !important;
      height: 100% !important;
    }

    #Banner-{{ section.id }} .banner__media img,
    #Banner-{{ section.id }} .banner__media svg {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      display: block !important;
    }

    #Banner-{{ section.id }} .banner__media::after {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0) 52%, rgba(255, 255, 255, 0.9) 100%) !important;
    }

    #Banner-{{ section.id }} .banner__content {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      height: auto !important;
      display: block !important;
      margin-top: -28px !important;
      z-index: 2 !important;
    }
  }

  #Banner-{{ section.id }} .banner__box {
    background: transparent !important;
    padding: 28px 30px !important;
    box-shadow: none !important;
    border: none !important;
    width: min(500px, 100%) !important;
    min-width: 0 !important;
    text-align: left !important;
    color: #111111 !important;
  }
  
  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} .banner__box {
      padding: 18px 16px 22px !important;
      width: 100% !important;
      max-width: none !important;
      background: rgba(255, 255, 255, 0.98) !important;
      border-radius: 24px 24px 0 0 !important;
      box-shadow: 0 -12px 30px rgba(17, 17, 17, 0.06) !important;
    }
  }

  #Banner-{{ section.id }} .hero-landing__badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid rgba(232, 119, 34, 0.2);
    background: rgba(255, 255, 255, 0.82);
    color: #c66b1f;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    margin-bottom: 16px;
    box-shadow: 0 12px 30px rgba(17, 17, 17, 0.08);
    backdrop-filter: blur(8px);
  }

  #Banner-{{ section.id }} .hero-landing__badge-dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(180deg, #ffa53a 0%, #e87722 100%);
    box-shadow: 0 0 12px rgba(232, 119, 34, 0.45);
  }

  #Banner-{{ section.id }} .banner__heading {
    margin: 0 !important;
    max-width: 480px;
    font-family: 'Inter', sans-serif !important;
    font-size: clamp(2.3rem, 3.7vw, 4rem) !important;
    font-weight: 900 !important;
    line-height: 1.01 !important;
    letter-spacing: -0.05em !important;
    color: #111111 !important;
  }

  #Banner-{{ section.id }} .banner__heading em {
    font-style: normal;
    color: #e87722 !important;
    white-space: nowrap !important;
  }

  #Banner-{{ section.id }} .banner__text {
    margin-top: 14px !important;
    max-width: 450px;
  }

  #Banner-{{ section.id }} .banner__text p {
    margin: 0 !important;
    color: rgba(17, 17, 17, 0.72) !important;
    font-family: 'Inter', sans-serif !important;
    font-size: clamp(1.08rem, 1.18vw, 1.34rem) !important;
    line-height: 1.5 !important;
    letter-spacing: -0.02em !important;
  }

  #Banner-{{ section.id }} .banner__buttons {
    display: flex !important;
    flex-wrap: wrap !important;
    align-items: center !important;
    gap: 14px !important;
    margin-top: 20px !important;
  }

  #Banner-{{ section.id }} .button {
    min-height: 44px !important;
    border-radius: 40px !important;
    padding: 0 18px !important;
    font-family: 'Inter', sans-serif !important;
    font-weight: 800 !important;
    font-size: 14px !important;
    border: 1px solid rgba(17, 17, 17, 0.12) !important;
    box-shadow: none !important;
    text-transform: none !important;
    margin: 0 !important;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    position: relative !important;
  }

  #Banner-{{ section.id }} .button--secondary {
    background: #E87722 !important;
    color: #ffffff !important;
    border-color: rgba(232, 119, 34, 0.22) !important;
    box-shadow: none !important;
  }

  #Banner-{{ section.id }} .button--secondary:hover {
    background: #C5611A !important;
  }

  #Banner-{{ section.id }} .button--primary {
    background: rgba(37, 211, 102, 0.12) !important;
    color: #1E8C45 !important;
    border: 1.5px solid rgba(37, 211, 102, 0.3) !important;
    box-shadow: none !important;
    backdrop-filter: none !important;
  }

  #Banner-{{ section.id }} .button--primary:hover {
    background: #25D366 !important;
    color: #ffffff !important;
    box-shadow: none !important;
  }

  #Banner-{{ section.id }} .button:hover {
    transform: none !important;
  }
  
  #Banner-{{ section.id }} .button::after {
    display: none !important;
  }

  #Banner-{{ section.id }} .button::before {
    display: none !important;
  }

  #Banner-{{ section.id }} .hero-landing__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px;
    width: min(480px, 100%);
    margin-top: 48px;
  }

  #Banner-{{ section.id }} .hero-landing__stat {
    min-width: 0;
    padding-right: 0;
    border-right: none;
  }

  #Banner-{{ section.id }} .hero-landing__stat:last-child {
    border-right: none;
  }

  #Banner-{{ section.id }} .hero-landing__stat-value {
    margin: 0 0 8px;
    font-family: 'Inter', sans-serif;
    font-size: clamp(1.55rem, 1.95vw, 2.45rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.05em;
    color: #111111;
  }

  #Banner-{{ section.id }} .hero-landing__lerc-logo {
    height: 1.1em;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    vertical-align: middle;
    margin-top: -4px;
  }

  #Banner-{{ section.id }} .hero-landing__stat-label {
    margin: 0;
    color: rgba(17, 17, 17, 0.75);
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 989px) {
    #Banner-{{ section.id }} .banner__box {
      padding: 24px 20px !important;
      width: min(390px, 100%) !important;
    }

    #Banner-{{ section.id }} .hero-landing__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 20px;
    }
  }

  @media screen and (max-width: 749px) {
    #Banner-{{ section.id }} .hero-landing__badge {
      font-size: 0.82rem;
      padding: 9px 13px;
      letter-spacing: 0.06em;
      margin-bottom: 12px;
    }

    #Banner-{{ section.id }} .banner__box {
      padding: 24px 20px 28px !important;
    }

    #Banner-{{ section.id }} .banner__heading {
      font-size: clamp(1.95rem, 7.2vw, 2.65rem) !important;
      max-width: 100%;
    }

    #Banner-{{ section.id }} .banner__text {
      margin-top: 14px !important;
      max-width: 100%;
    }

    #Banner-{{ section.id }} .banner__text p {
      font-size: 0.98rem !important;
      line-height: 1.42 !important;
    }

    #Banner-{{ section.id }} .banner__buttons {
      gap: 12px !important;
      margin-top: 18px !important;
    }

    #Banner-{{ section.id }} .button {
      width: 100% !important;
      justify-content: center !important;
      min-height: 46px !important;
      font-size: 14px !important;
    }

    #Banner-{{ section.id }} .hero-landing__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 16px;
      margin-top: 32px;
      width: 100%;
      text-align: center;
    }

    #Banner-{{ section.id }} .hero-landing__stat-value {
      font-size: 1.45rem;
      margin-bottom: 4px;
    }

    #Banner-{{ section.id }} .hero-landing__lerc-logo {
      height: 1.65em;
      margin-top: -6px;
    }

    #Banner-{{ section.id }} .hero-landing__stat-label {
      font-size: 0.75rem;
      opacity: 0.85;
    }
  }
</style>

{%- if section.settings.image_height == 'adapt' and section.settings.image != blank -%}
  {%- style -%}
    @media screen and (max-width: 749px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before,
      #Banner-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }

    @media screen and (min-width: 750px) {
      #Banner-{{ section.id }}::before,
      #Banner-{{ section.id }} .banner__media::before {
        padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{%- style -%}
  #Banner-{{ section.id }}::after {
    opacity: {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  if section.settings.image_behavior == 'ambient'
    assign half_width = '60vw'
    assign full_width = '120vw'
    assign stacked_sizes = '(min-width: 750px) 60vw, 120vw'
    assign widths = '450, 660, 900, 1320, 1800, 2136, 2400, 3600, 7680'
  elsif section.settings.image_behavior == 'fixed' or section.settings.image_behavior == 'zoom-in'
    assign half_width = '100vw'
    assign stacked_sizes = '100vw'
  else
    assign half_width = '50vw'
    assign stacked_sizes = '(min-width: 750px) 50vw, 100vw'
  endif
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
-%}

<div
  id="Banner-{{ section.id }}"
  class="banner banner--content-align-{{ section.settings.desktop_content_alignment }} banner--content-align-mobile-{{ section.settings.mobile_content_alignment }} banner--{{ section.settings.image_height }}{% if section.settings.stack_images_on_mobile and section.settings.image != blank and section.settings.image_2 != blank %} banner--stacked{% endif %}{% if section.settings.image_height == 'adapt' and section.settings.image != blank %} banner--adapt{% endif %}{% if section.settings.show_text_below %} banner--mobile-bottom{%- endif -%}{% if section.settings.show_text_box == false %} banner--desktop-transparent{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="svarakshit-banner-slideshow">
    {%- assign has_images = false -%}
    
    <!-- Slide 1 -->
    {%- if section.settings.image != blank -%}
      {%- assign has_images = true -%}
      <div class="banner__slide active" data-slide="0">
        <div class="banner__media banner__media--desktop media{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
          {{ section.settings.image | image_url: width: 3840 | image_tag: widths: widths, fetchpriority: fetch_priority, class: 'slideshow-image' }}
        </div>
      </div>
    {%- endif -%}

    <!-- Slide 2 -->
    {%- if section.settings.desktop_image_2 != blank -%}
      {%- assign has_images = true -%}
      <div class="banner__slide" data-slide="1">
        <div class="banner__media banner__media--desktop media{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
          {{ section.settings.desktop_image_2 | image_url: width: 3840 | image_tag: widths: widths, fetchpriority: fetch_priority, class: 'slideshow-image' }}
        </div>
      </div>
    {%- endif -%}

    <!-- Slide 3 -->
    {%- if section.settings.desktop_image_3 != blank -%}
      {%- assign has_images = true -%}
      <div class="banner__slide" data-slide="2">
        <div class="banner__media banner__media--desktop media{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
          {{ section.settings.desktop_image_3 | image_url: width: 3840 | image_tag: widths: widths, fetchpriority: fetch_priority, class: 'slideshow-image' }}
        </div>
      </div>
    {%- endif -%}
    
    <!-- Slide 4 -->
    {%- if section.settings.desktop_image_4 != blank -%}
      {%- assign has_images = true -%}
      <div class="banner__slide" data-slide="3">
        <div class="banner__media banner__media--desktop media{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %}">
          {{ section.settings.desktop_image_4 | image_url: width: 3840 | image_tag: widths: widths, fetchpriority: fetch_priority, class: 'slideshow-image' }}
        </div>
      </div>
    {%- endif -%}

    {%- if has_images == false -%}
      <div class="banner__media banner__media--desktop media placeholder">
        {%- assign _banner_heading_block = section.blocks | where: 'type', 'heading' | first -%}
        {%- assign _banner_fallback_context = _banner_heading_block.settings.heading | default: 'hero banner' -%}
        {% render 'svarakshit-fallback-image',
          context: _banner_fallback_context,
          alt: 'Svarakshit hero banner',
          class: 'placeholder-svg',
          loading: 'eager',
          width: 1600,
          height: 1000
        %}
      </div>
    {%- endif -%}
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const slides = document.querySelectorAll('#Banner-{{ section.id }} .banner__slide');
      if (slides.length <= 1) return;

      let currentSlide = 0;
      
      if (typeof gsap !== 'undefined') {
        gsap.set(slides, { opacity: 0, zIndex: 0 });
        gsap.set(slides[0], { opacity: 1, zIndex: 1 });

        setInterval(() => {
          let nextSlide = (currentSlide + 1) % slides.length;
          
          gsap.to(slides[currentSlide], {
            opacity: 0,
            duration: 1,
            zIndex: 0,
            ease: "power2.inOut"
          });
          
          gsap.to(slides[nextSlide], {
            opacity: 1,
            duration: 1,
            zIndex: 1,
            ease: "power2.inOut"
          });
          
          currentSlide = nextSlide;
        }, 4500);
      } else {
        setInterval(() => {
          let nextSlide = (currentSlide + 1) % slides.length;
          slides[currentSlide].classList.remove('active');
          slides[nextSlide].classList.add('active');
          currentSlide = nextSlide;
        }, 4500);
      }
    });
  </script>
  <div class="banner__content banner__content--{{ section.settings.desktop_content_position }} page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="banner__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }} gradient">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2
              class="banner__heading inline-richtext {{ block.settings.heading_size }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.heading }}
            </h2>
          {%- when 'text' -%}
            <div class="banner__text rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- when 'buttons' -%}
            <div
              class="banner__buttons{% if block.settings.button_label_1 != blank and block.settings.button_label_2 != blank %} banner__buttons--multiple{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.button_label_1 != blank -%}
                <a
                  {% if block.settings.button_link_1 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_1 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_1 %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {% assign label_1_downcase = block.settings.button_label_1 | downcase %}
                  {%- if label_1_downcase contains 'whatsapp' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                    </svg>
                  {%- endif -%}
                  {{- block.settings.button_label_1 | escape -}}
                </a>
              {%- endif -%}
              {%- if block.settings.button_label_2 != blank -%}
                <a
                  {% if block.settings.button_link_2 == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.button_link_2 }}"
                  {% endif %}
                  class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                >
                  {% assign label_2_downcase = block.settings.button_label_2 | downcase %}
                  {%- if label_2_downcase contains 'whatsapp' -%}
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
