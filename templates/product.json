    "swarakshit_faq_contact": {
      "type": "swarakshit-faq-contact",
      "blocks": {
        "faq1": {
          "type": "faq",
          "settings": {
            "question": "What gases does Swarakshit detect?",
            "answer": "<p>Swarakshit detects all combustible gases including LPG, PNG, CNG, methane, propane, butane and other hydrocarbons. It is NOT designed to detect CO (carbon monoxide) — for CO, you need a dedicated CO alarm.</p>"
          }
        },
        "faq2": {
          "type": "faq",
          "settings": {
            "question": "What does LERC certification mean?",
            "answer": "<p>LERC (Liquefied Petroleum Gas Equipment Research Centre) is India's premier government-recognized body for testing and certifying LPG safety equipment. LERC certification means the device has been independently tested for accuracy, sensitivity, and durability — the gold standard in India.</p>"
          }
        },
        "faq3": {
          "type": "faq",
          "settings": {
            "question": "How long does the battery last?",
            "answer": "<p>The built-in rechargeable battery lasts 8–10 hours of continuous use. For typical home use (5–10 minute daily checks), the battery lasts several weeks between charges. USB charging takes approximately 2 hours to full.</p>"
          }
        },
        "faq4": {
          "type": "faq",
          "settings": {
            "question": "Can I use it for commercial kitchens?",
            "answer": "<p>Swarakshit is designed first for homes and kitchens. It may also be useful in selected small commercial kitchen setups where regular combustible gas checks are needed. If you have a specialized or bulk requirement, contact us before ordering so we can guide you properly.</p>"
          }
        },
        "faq5": {
          "type": "faq",
          "settings": {
            "question": "What is the warranty and return policy?",
            "answer": "<p>Every Swarakshit device comes with a 1-year manufacturer's warranty and a 30-day no-questions-asked return policy. Contact us at info@rakshit.net.in or call 9529154548.</p>"
          }
        },
        "faq6": {
          "type": "faq",
          "settings": {
            "question": "How often should I test for gas leaks?",
            "answer": "<p>Weekly — around LPG cylinder and rubber pipe connections. Monthly — around all gas appliances including geysers. Immediately — after any new appliance installation or if you smell even a faint gas odour.</p>"
          }
        },
        "faq7": {
          "type": "faq",
          "settings": {
            "question": "Is it safe to use if I already smell gas?",
            "answer": "<p>If you already smell strong gas, DO NOT use any electrical device including Swarakshit. Immediately turn off the main gas valve, open all windows, evacuate, and call your gas agency. Use Swarakshit for routine preventive checks when no visible leak is apparent.</p>"
          }
        }
      },
